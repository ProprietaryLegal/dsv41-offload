# R-UPX 0085b (henryous idle cache release, UPAUDIT B33) as an append step: source it AFTER a base config has set OVERLAYS,
# EXP_DOCKER_ENV and LABEL (offload/upx/UPX.env does; another lane's window.env may end with the same line). It reads and
# extends those three and nothing else.
#   UPX_0085B=0       nothing: the base config exactly (the default)
#   UPX_0085B=tokens  mount the two overlay files + VLLM_DSV41_RELEASE_TOKENS=$UPX_RELEASE_TOKENS (default 131072, the
#                     donor's serve setting; 0 = mounted but off)
#   UPX_0085B=file    mount the two overlay files + VLLM_DSV41_RELEASE_FILE=/root/.cache/dsv41-release-tokens: the threshold
#                     is read from ~/.cache/dsv41-serve/dsv41-release-tokens on EACH node at every idle check (the launcher
#                     mounts ~/.cache/dsv41-serve at /root/.cache). A missing file reads as 0 = no release; the runner
#                     writes the same value on both nodes (configs.release_file_command).
UPX_0085B=${UPX_0085B-0}
UPX_RELEASE_TOKENS=${UPX_RELEASE_TOKENS-131072}
case "$UPX_0085B" in 0|tokens|file) ;; *) echo "invalid UPX_0085B=$UPX_0085B" >&2; return 1 ;; esac
case "$UPX_RELEASE_TOKENS" in ''|*[!0-9]*) echo "invalid UPX_RELEASE_TOKENS=$UPX_RELEASE_TOKENS" >&2; return 1 ;; esac
if [ "$UPX_0085B" != 0 ]; then
  upx_py=/usr/local/lib/python3.12/dist-packages
  for upx_rel in vllm/v1/engine/core.py vllm/v1/worker/gpu_worker.py; do
    case " ${OVERLAYS-} " in *"=$upx_py/$upx_rel "*) echo "UPX_0085B: the base config already mounts $upx_rel" >&2; return 1 ;; esac
    case " ${EXTRA_DOCKER_ARGS-} " in *":$upx_py/$upx_rel:"*) echo "UPX_0085B: the base config already mounts $upx_rel" >&2; return 1 ;; esac
    OVERLAYS="${OVERLAYS:+$OVERLAYS }offload/upx/overlay/$upx_rel=$upx_py/$upx_rel"
  done
  for upx_env in ${EXP_DOCKER_ENV-}; do
    case "$upx_env" in VLLM_DSV41_RELEASE_*) echo "UPX_0085B: the base config already sets $upx_env" >&2; return 1 ;; esac
  done
  if [ "$UPX_0085B" = tokens ]; then upx_switch=VLLM_DSV41_RELEASE_TOKENS=$UPX_RELEASE_TOKENS
  else upx_switch=VLLM_DSV41_RELEASE_FILE=/root/.cache/dsv41-release-tokens; fi
  EXP_DOCKER_ENV="${EXP_DOCKER_ENV:+$EXP_DOCKER_ENV }$upx_switch"
  LABEL="${LABEL-exp}-0085b-$UPX_0085B"
  unset upx_py upx_rel upx_env upx_switch
fi
