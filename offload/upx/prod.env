# R-UPX production-exact base (as NBW-native.env's K role and R-UP3/PC1 window.env): today's production env, drafter env
# and docker mounts, read from the production checkout's dsv41.env, port 8001. Sourced by UPX.env (UPX_BASE=prod) from the
# experiment checkout root; production is read-only. No inherited overrides, cap, KV or policy change is permitted.
for upx_key in K1_KV_PAIR K1_DROP_MTP K1_TF_TRANSIENT K1_TF_ALIAS K1_INDEXER_FACTOR K1_KV_BYTES K1_MEMPROBE K1_NODROP \
    SPEC_OVERRIDE EXP_EXTRA_ARGS OVERLAYS EXTRA_DOCKER_ARGS EXP_DOCKER_ENV KV_BYTES_OVERRIDE MAX_LEN_OVERRIDE; do
  if [ -n "${!upx_key-}" ]; then echo "UPX STOP: inherited $upx_key" >&2; return 1; fi
done
UPX_PROD_ENV=${UPX_PROD_ENV-$HOME/dsv41-deploy/dsv41.env}
[ -f "$UPX_PROD_ENV" ] || { echo 'UPX STOP: production env missing' >&2; return 1; }
upx_prod=$(set +u; . "$UPX_PROD_ENV" >/dev/null || exit 1
  printf '%s\n' "${OFFLOAD_DOCKER_ENV-}" "${OFFLOAD_DSPARK_ENV-}" "${OFFLOAD_DOCKER_ARGS-}" \
    "${PROD_KV_BYTES-}" "${PROD_MAX_LEN-}" "${PROD_K1-}" "${PROD_K1_PROFILE-}") || return 1
mapfile -t upx_lines <<< "$upx_prod"
[ "${#upx_lines[@]}" = 7 ] && [ "${upx_lines[3]}:${upx_lines[4]}:${upx_lines[5]}:${upx_lines[6]}" = 6442450944:327680:1:327680 ] \
  || { echo 'UPX STOP: production KV/cap/K1 ledger changed' >&2; return 1; }
upx_env="${upx_lines[0]} ${upx_lines[1]}"
for upx_need in VLLM_DSV41_KV_PAIR=3 VLLM_DSV41_DROP_MTP_BUFFER=1 VLLM_EXL3_TF_PROMPT_TRANSIENT=1 \
    VLLM_EXL3_TF_PROMPT_ALIAS=1 VLLM_INDEXER_PREFILL_BUFFER_FACTOR=4 VLLM_DSPARK_REMOTE_POLICY=capacity \
    VLLM_DSPARK_REMOTE_ASYNC=1 VLLM_DSPARK_REMOTE_ASYNC_PROXY=process; do
  case " $upx_env " in *" $upx_need "*) ;; *) echo "UPX STOP: production lacks $upx_need" >&2; return 1 ;; esac
done
MAX_LEN_OVERRIDE=${upx_lines[4]}
KV_BYTES_OVERRIDE=${upx_lines[3]}
EXP_DOCKER_ENV=$upx_env
EXTRA_DOCKER_ARGS=${upx_lines[2]}
OVERLAYS=
LABEL=UPX-prod
unset upx_key upx_prod upx_lines upx_env upx_need
