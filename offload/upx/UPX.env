# R-UPX arm config for offload/launch/start_exp.sh: henryous 0085b idle cache release (UPAUDIT B33) on a base config.
# Everything OFF by default: with UPX_0085B=0 this is exactly its base config (offload/upx/tests/test_configs.py).
# Source from the repository root, like start_exp.sh. Arms: offload/upx/configs.py; windows: offload/upx/WINDOWS.md.
UPX_BASE=${UPX_BASE-k1}   # k1 = K1 production equivalent (D-kv6-async-pack.env); 0075 = UP2 replay-skip config (UP2-0075.env)
case "$UPX_BASE" in k1|0075) ;; *) echo "invalid UPX_BASE=$UPX_BASE" >&2; return 1 ;; esac
if [ "$UPX_BASE" = k1 ]; then source offload/launch/configs/D-kv6-async-pack.env || return 1
else source offload/launch/configs/UP2-0075.env || return 1; fi
source offload/upx/x0085b.env || return 1
