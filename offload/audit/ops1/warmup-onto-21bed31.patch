 #!/usr/bin/env bash
-# One warm-up request once the serve answers (R3-PROMOTE; configuration D-async keeps CUDA_MODULE_LOADING=LAZY because
-# EAGER costs ~18 min per start). The first request after a start pays the lazy module loads of the kernels it is the
-# first to use (window 4, COMPARISON.md: 0.55 s on a short request, ~1.1 s at 32K). This request pays them instead: a
-# ~6,000-token prompt (one full 4,096-token prefill chunk and a partial one) and 32 greedy tokens (decode, the remote
-# draft round, the proxy process's first rounds). The output is discarded; the elapsed time is printed.
-#   offload/launch/warmup_serve.sh [port] [served-model-name]     (defaults: PORT / SERVED from dsv41.env)
-# start.sh runs it after serve.sh when OFFLOAD_DSPARK_ENV sets VLLM_DSPARK_REMOTE_ASYNC=1; a failure is a warning there.
+# Internal startup requests only. The coordinator holds/drains producers first.
+# No changes to server defaults or production sampling. See OPERATIONS.md.
 set -euo pipefail
 cd "$(dirname "$0")/../.."
 if [ -f dsv41.env ]; then set -a; . ./dsv41.env; set +a; fi
-port=${1:-${PORT:-8000}}
-model=${2:-${SERVED:?served model name (argument 2 or SERVED in dsv41.env)}}
-base=http://localhost:$port
-curl -sf -m 10 "$base/v1/models" >/dev/null || { echo "warm-up: no serve answering on :$port" >&2; exit 1; }
-text=""
-for i in $(seq 1 240); do
-  text+="Paragraph $i. The court considers the record before it, the testimony of each witness and the exhibits. "
-done
-payload=$(printf '{"model": "%s", "prompt": "%s", "max_tokens": 32, "temperature": 0}' "$model" "$text")
-t0=$(date +%s%N)
-out=$(curl -sf -m 600 -H 'Content-Type: application/json' -d "$payload" "$base/v1/completions") \
-  || { echo "warm-up: the request failed" >&2; exit 1; }
-ms=$(( ($(date +%s%N) - t0) / 1000000 ))
-usage=$(printf '%s' "$out" | grep -o '"prompt_tokens": *[0-9]*\|"completion_tokens": *[0-9]*' | tr -d ' "' | tr '\n' ' ')
-echo "warm-up request: $((ms / 1000)).$(printf %03d $((ms % 1000))) s (${usage:-no usage in the reply})"
+exec python3 offload/launch/warmup.py --port "${1:-${PORT:-8000}}" \
+  --model "${2:-${SERVED:?served model name (argument 2 or SERVED)}}"
