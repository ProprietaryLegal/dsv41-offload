    ["prefetch", "\\bl2pf_kernel\\b"],
    ["collectives", "\\b(stage_kernel|sum_kernel|gather_kernel)\\b"],
    ["collectives", "nccl|cross_device_reduce|custom_ar|all_?reduce|all_?gather|reduce_?scatter|AllReduce|AllGather|ReduceScatter"],
    ["engram", "engram|\\b_hash_ids_kernel\\b|\\b_write_hash_cache_kernel\\b"],
    ["drafter", "markov|dspark|eagle|dflash|\\b_suffix_match_kernel\\b|\\b_selector_walk_kernel\\b|\\b_predict_kernel\\b|\\b_trace_replay_kernel\\b|\\b_update_draft_inputs_kernel\\b|\\b_pad_trailing_draft_slots_kernel\\b"],
    ["sampler", "rejection|sample|gumbel|\\b_topk_topp_kernel\\b|\\b_topp_sb_|\\b_min_p_kernel\\b|\\b_temperature_kernel\\b|\\b_penalties_kernel\\b|\\b_bad_words_kernel\\b|logprob|\\b_argmax_finish(_vi)?_kernel\\b|\\b_resample_kernel\\b|\\b_thinking_budget_kernel\\b|\\b_compute_local_logits_stats_kernel\\b|\\b_local_max_sumexp_kernel\\b|\\b_compute_local_residual_mass_kernel\\b|\\b_compute_cumulative_log_p_kernel\\b|\\b_bias_kernel\\b|\\b_repeated_context_mask_kernel\\b|\\b_compact_sampling_mask_kernel\\b|\\b_bincount_kernel\\b|\\b_ranks_kernel\\b|\\b_cache_draft_logits_kernel\\b"],
