    ["other", "\\bmhc_|post_collapse|\\b_hc_|collapse|rms_norm|layer_norm|\\b_prescale_kernel\\b|swiglu|silu|\\bactivation_kernel\\b|\\b_act_qdq_kernel\\b|\\b_amax_kernel\\b|elementwise|vectorized|reduce_kernel|index|scatter|gather|copy|fill|\\bcat\\b|CatArray|embedding|_prepare_|\\b_cache_inputs_kernel\\b|\\bexpand_kernel\\b|_flatten|_pack_|_unpack_|_shift_input|\\b_accumulate_kernel\\b|\\b_refit_kernel\\b|\\b_build_shard_plan_kernel\\b|\\b_insert_resampled_kernel\\b|\\b_update_committed_marker_cache_kernel\\b|^Memcpy|^Memset"]
  ],
  "wait_rules_note": "GPU idle inside a step period is classified by the activity that ends it. A wait rule applies when that activity's name matches 'next' and either its launch call is not in the trace ('unrecorded': kineto keeps no cuMemcpyHtoDAsync/cuStreamWaitValue32 driver call) or the recorded launch matches 'launch' and was issued before the idle began. Otherwise: launch issued before the idle -> device_wait; after -> host_gap; launch not recorded -> unrecorded_wait. ESTIMATED attribution from trace structure (offload/dspark/spark/remote_dspark/streamsync.py: WAIT released -> H2D reply).",
  "wait_rules": [
    {"bucket": "drafter", "next": "^Memcpy HtoD", "launch": "^cuMemcpyHtoDAsync", "unrecorded": true},
    {"bucket": "engram", "next": "engram", "launch": null, "unrecorded": true}
  ],
  "graph_launch": "^cudaGraphLaunch|^cuGraphLaunch",
  "report_buckets": ["routed_moe", "prefetch", "dense_gemm", "attention", "collectives", "engram", "sampler", "drafter", "host_gap", "device_wait", "unrecorded_wait", "other", "unmatched"],
  "limits": {
    "profiler_overhead_max": 0.10,
    "coverage_min": 0.90
  },
  "hypotheses_note": "Metric keys are '<cell>:<capture>.share.<bucket>' (fraction of the summed GPU step/chunk periods, both ranks averaged) and '<cell>:<capture>.ms.<bucket>' (mean ms per step) plus '<cell>:<capture>.idle_share' and '<cell>:<capture>.collective_imbalance_ms'. A hypothesis is SUPPORTED when any listed key pattern (fnmatch) reaches its minimum; supported ones are ranked by the largest 'addressable' share, then by experiments.json rank.",
  "hypotheses": [
    {"id": "prefill-grouped-kernel", "any": [["*:prefill-*.share.routed_moe", 0.40]], "addressable": "*:prefill-*.share.routed_moe",
     "then": "kernel lane: TF prompt grouped kernel (SM121 tiling, scratch)"},
    {"id": "decode-smoe-bandwidth", "any": [["*:decode.share.routed_moe", 0.40]], "addressable": "*:decode.share.routed_moe",
     "then": "kernel lane: smoe PIPE/OBI/CTA-tail sweep"},
    {"id": "chunk-threshold-grid", "any": [["*:prefill-*.idle_share", 0.10]], "addressable": "*:prefill-*.idle_share",
     "then": "chunk grid window (2048/4096; 8192 only after the headroom gate)"},
    {"id": "clocks-and-cooling", "trace": false, "then": "telemetry question (clocks, power, temperature), not answered by kernel traces"},
    {"id": "remaining-host-gaps", "any": [["*:decode.ms.host_gap", 0.5]], "addressable": "*:decode.share.host_gap",
     "then": "host-gap lane (launch path, sample_tokens, async scheduling)"},
    {"id": "collective-boundary-fusion", "any": [["*:decode.share.collectives", 0.05], ["*:decode.collective_imbalance_ms", 1.0]],
     "addressable": "*:decode.share.collectives", "then": "collective fusion lane (RDMA ring boundaries)"},
    {"id": "verify-coverage-and-width", "any": [["*:decode.share.sampler", 0.05]], "addressable": "*:decode.share.sampler",
     "then": "verify/rejection width lane"},
    {"id": "depth-policy-recalibration", "any": [["*:decode.share.drafter", 0.10]], "addressable": "*:decode.share.drafter",
     "then": "depth A/B window (drafter round exposed on the engine stream)"},
    {"id": "expert-parallel-split", "any": [["prof-32k-b4:decode.share.routed_moe", 0.50]], "addressable": "prof-32k-b4:decode.share.routed_moe",
     "then": "EP feasibility study only (B1 regression possible)"},
    {"id": "kv-dtype-change", "trace": false, "then": "excluded: experiments.json records no justified deployable gain"}
  ]
}
