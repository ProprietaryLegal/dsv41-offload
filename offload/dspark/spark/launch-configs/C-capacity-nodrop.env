# DSV41-OFFLOAD lane O3 (O3-FIX): C-capacity plus "disable_eagle_block_drop": true in SPEC. Only for the prefix-cache
# check of INTEGRATION.md §5 ("KV group annotation and prefix-cache hits"): without the drafter's KV layers the positional
# eagle-group fallback flags a TARGET group, whose trailing block is then dropped from prefix hits. Capacity mode has no
# local draft KV, so the drop protects nothing there. NEVER use this SPEC with resilience or shadow (they keep draft KV).
# Same placeholders and transport notes as C-capacity.env.
LABEL=C-capacity-nodrop
SPEC_OVERRIDE='{"method":"dspark","num_speculative_tokens":5,"num_speculative_tokens_per_batch_size":[[1,2,5],[3,4,4]],"disable_eagle_block_drop":true}'
OVERLAYS="offload/dspark/spark/remote_dspark=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/remote_dspark offload/dspark/spark/overlay/vllm/v1/worker/gpu/spec_decode/__init__.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/__init__.py"
EXTRA_DOCKER_ARGS="-v \$HOME/dsv41-offload-run/ofl:/opt/dsv41-ofl:ro"
EXP_DOCKER_ENV="VLLM_DSPARK_REMOTE=o1rdma://10.202.28.1:18620 VLLM_DSPARK_REMOTE_BIND=10.202.28.2 VLLM_DSPARK_REMOTE_OFL_DIR=/opt/dsv41-ofl VLLM_DSPARK_REMOTE_POLICY=capacity VLLM_DSPARK_REMOTE_IDENTITY=be2c1436fa9f9e66b398e1b1da2e140e6fddc82a11939e2ac4240a0ca79543bd VLLM_DSPARK_REMOTE_MARKOV_IDENTITY=0b6e71e638abd5abce2db433965bb5ff523cbbe92ed7ae54324a50ccaeffa19a VLLM_DSPARK_REMOTE_TIMEOUT_MS=50 VLLM_DSPARK_REMOTE_ROUND_MS=29.66,32.73,35.31,38.63,42.43,44.55 VLLM_DSPARK_REMOTE_DRAFT_MS=4.0 VLLM_DSPARK_REMOTE_LOG_EVERY=1024"
