# UP3 only. Exact production base, one isolated arm; never source the historical UP1/PF1 configs.
for up3_key in K1_KV_PAIR K1_DROP_MTP K1_TF_TRANSIENT K1_TF_ALIAS K1_INDEXER_FACTOR K1_KV_BYTES K1_MEMPROBE K1_NODROP \
    SPEC_OVERRIDE EXP_EXTRA_ARGS OVERLAYS EXTRA_DOCKER_ARGS EXP_DOCKER_ENV KV_BYTES_OVERRIDE MAX_LEN_OVERRIDE; do
  if [ -n "${!up3_key-}" ]; then echo "UP3 STOP: inherited $up3_key" >&2; return 1; fi
done
UP3_ARM=${UP3_ARM-control}
case "$UP3_ARM" in control|split|cpu-pin|vor|k5|dual-ring|fixed2|defer|ring-defer) ;; *) echo 'UP3 STOP: isolated arm required' >&2; return 1 ;; esac
UP3_PROD_ENV=${UP3_PROD_ENV-$HOME/dsv41-deploy/dsv41.env}
up3_prod=$(set +u; . "$UP3_PROD_ENV" >/dev/null || exit 1
  printf '%s\n' "${OFFLOAD_DOCKER_ENV-}" "${OFFLOAD_DSPARK_ENV-}" "${OFFLOAD_DOCKER_ARGS-}" \
    "${PROD_KV_BYTES-}" "${PROD_MAX_LEN-}" "${PROD_K1-}" "${PROD_K1_PROFILE-}") || return 1
mapfile -t up3_lines <<< "$up3_prod"
[ "${#up3_lines[@]}" = 7 ] && [ "${up3_lines[3]}:${up3_lines[4]}:${up3_lines[5]}:${up3_lines[6]}" = 6442450944:327680:1:327680 ] \
  || { echo 'UP3 STOP: production KV/cap/K1 changed' >&2; return 1; }
MAX_LEN_OVERRIDE=${up3_lines[4]}
KV_BYTES_OVERRIDE=${up3_lines[3]}
EXP_DOCKER_ENV="${up3_lines[0]} ${up3_lines[1]}"
EXTRA_DOCKER_ARGS=${up3_lines[2]}
OVERLAYS=
LABEL=UP3-$UP3_ARM
case "$UP3_ARM" in
  split) EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_EXL3_MOE_SPLIT_MAX_TOKENS=63" ;;
  cpu-pin) EXP_DOCKER_ENV="$EXP_DOCKER_ENV EXL3_CPU_PIN=5-9,15-19" ;;
  vor) EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_DSV41_VOR_FUSED=1" ;;
  k5) SPEC_OVERRIDE='{"method":"dspark","num_speculative_tokens":5,"num_speculative_tokens_per_batch_size":[[1,4,5]]}' ;;
  dual-ring) EXP_DOCKER_ENV="$EXP_DOCKER_ENV EXL3_RDMA_DEVICES=rocep1s0f1,roceP2p1s0f1" ;;
  fixed2) EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_DSPARK_DEPTH_POLICY=fixed:2 VLLM_DSV41_ADAPTIVE_K=0"
    SPEC_OVERRIDE='{"method":"dspark","num_speculative_tokens":5,"num_speculative_tokens_per_batch_size":[[1,4,5]]}' ;;
  defer) EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_DSV41_INDEXER_DEFER=1" ;;
  ring-defer) EXP_DOCKER_ENV="$EXP_DOCKER_ENV EXL3_RDMA_DEVICES=rocep1s0f1,roceP2p1s0f1 VLLM_DSV41_INDEXER_DEFER=1" ;;
esac
# Pin the runtime change list to this manifest, excluding replay and every other UP1 file.
if [ "$UP3_ARM" = split ] || [ "$UP3_ARM" = vor ] || [ "$UP3_ARM" = cpu-pin ]; then
  OVERLAYS=$(python3 -c 'import json,sys
from pathlib import Path
arm=sys.argv[1]; m=json.loads(Path("offload/up3/manifests",arm+".json").read_text())
print(" ".join("offload/up3/overlay/"+arm+"/"+p+"=/usr/local/lib/python3.12/dist-packages/"+p for p in m["files"]))' "$UP3_ARM") || return 1
fi
unset up3_key up3_prod up3_lines
