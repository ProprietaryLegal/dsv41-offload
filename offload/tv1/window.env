# Coordinator-only TV1 experiment. OFF unless explicit role and pinned overlay are supplied.
# Read OPS1 production directly; PF1/SP1 historically changed Engram REQUIRED.
for tv1_key in K1_KV_PAIR K1_DROP_MTP K1_TF_TRANSIENT K1_TF_ALIAS K1_INDEXER_FACTOR K1_KV_BYTES K1_MEMPROBE K1_NODROP \
    SPEC_OVERRIDE EXP_EXTRA_ARGS OVERLAYS EXTRA_DOCKER_ARGS EXP_DOCKER_ENV KV_BYTES_OVERRIDE MAX_LEN_OVERRIDE \
    PF1_TRACE_RUN PF1_TRACE_ROOT PF1C_TF_TRANSIENT SP1_PROFILER_CONFIG AK_MARGIN AK_MIN AK_HI AK_MAX_REQS; do
  if [ -n "${!tv1_key-}" ]; then echo "TV1 STOP: inherited $tv1_key" >&2; return 1; fi
done
case "${PF1_CAP-327680}:${PF1_TRACE-0}:${PF1_EAGER-0}" in
  327680:0:0) ;; *) echo 'TV1 STOP: only the production cap and untraced base are permitted' >&2; return 1 ;;
esac
TV1_PROD_ENV=${TV1_PROD_ENV-$HOME/dsv41-deploy/dsv41.env}
[ -f "$TV1_PROD_ENV" ] || { echo 'TV1 STOP: production env missing' >&2; return 1; }
tv1_prod=$(set +u; . "$TV1_PROD_ENV" >/dev/null || exit 1
  printf '%s\n' "${OFFLOAD_DOCKER_ENV-}" "${OFFLOAD_DSPARK_ENV-}" "${OFFLOAD_DOCKER_ARGS-}" \
    "${PROD_KV_BYTES-}" "${PROD_MAX_LEN-}" "${PROD_K1-}" "${PROD_K1_PROFILE-}") || return 1
mapfile -t tv1_base <<< "$tv1_prod"
[ "${#tv1_base[@]}" = 7 ] && [ "${tv1_base[3]}:${tv1_base[4]}:${tv1_base[5]}:${tv1_base[6]}" = 6442450944:327680:1:327680 ] \
  || { echo 'TV1 STOP: production KV/cap/K1 ledger changed' >&2; return 1; }
EXP_DOCKER_ENV="${tv1_base[0]} ${tv1_base[1]}"
for tv1_need in VLLM_DSV41_KV_PAIR=3 VLLM_DSV41_DROP_MTP_BUFFER=1 VLLM_EXL3_TF_PROMPT_TRANSIENT=1 \
    VLLM_EXL3_TF_PROMPT_ALIAS=1 VLLM_INDEXER_PREFILL_BUFFER_FACTOR=4 VLLM_ENGRAM_REMOTE_REQUIRED=0 \
    VLLM_DSPARK_REMOTE_POLICY=capacity VLLM_DSPARK_REMOTE_ASYNC=1 VLLM_DSPARK_REMOTE_ASYNC_PROXY=process; do
  case " $EXP_DOCKER_ENV " in *" $tv1_need "*) ;; *) echo "TV1 STOP: production lacks $tv1_need" >&2; return 1 ;; esac
done
MAX_LEN_OVERRIDE=${tv1_base[4]}
KV_BYTES_OVERRIDE=${tv1_base[3]}
# The reviewed SP1 profiler is idle until explicitly started; only this rw mount is added.
tv1_profiler='{"profiler":"torch","torch_profiler_dir":"/sp1-profile","torch_profiler_activities":["CPU","CUDA"],"torch_profiler_with_stack":false,"torch_profiler_with_flops":false,"torch_profiler_record_shapes":false,"torch_profiler_with_memory":false,"torch_profiler_use_gzip":true,"torch_profiler_dump_cuda_time_total":false,"ignore_frontend":true,"detailed_trace_annotation":true,"max_iterations":16}'
EXP_EXTRA_ARGS="--profiler-config '$tv1_profiler'"
EXTRA_DOCKER_ARGS="${tv1_base[2]} -v \$HOME/dsv41-offload-run/sp1-profile:/sp1-profile:rw"
TV1_ROLE=${TV1_ROLE-off}
: "${TV1_TREE:?TV1 pinned generated overlay tree required}"
# Capture status explicitly: process substitution would hide a failed Python guard.
tv1_result=$(python3 -m offload.tv1.window_config --root "$PWD" --role "$TV1_ROLE" --tree "$TV1_TREE" \
  --raw="$EXTRA_DOCKER_ARGS" --env="$EXP_DOCKER_ENV") || return 1
mapfile -t tv1_lines <<< "$tv1_result"
[ "${#tv1_lines[@]}" = 3 ] || { echo 'TV1 STOP: malformed mount composition' >&2; return 1; }
EXTRA_DOCKER_ARGS=${tv1_lines[0]}
OVERLAYS=${tv1_lines[1]}
EXP_DOCKER_ENV=${tv1_lines[2]}
LABEL=TV1-$TV1_ROLE
unset tv1_result tv1_lines tv1_key tv1_prod tv1_base tv1_need tv1_profiler
