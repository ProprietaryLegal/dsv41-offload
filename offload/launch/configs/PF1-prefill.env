# PF1 coordinator-only A/B; source after dsv41.env through start_exp.sh.
# Defaults: 524288 cap, candidate OFF, existing K1 factor 4.
. offload/launch/configs/D-kv6-async-pack.env
MAX_LEN_OVERRIDE=${PF1_CAP:-524288}
PF1_WORKSPACE=${PF1_WORKSPACE:-0}
case "$MAX_LEN_OVERRIDE" in 327680|393216|524288) ;; *) echo "PF1_CAP must be 327680, 393216 or 524288" >&2; return 1 ;; esac
case "$PF1_WORKSPACE" in 0|1) ;; *) echo "PF1_WORKSPACE must be 0 or 1" >&2; return 1 ;; esac
case "$K1_INDEXER_FACTOR" in 1|4) ;; *) echo "PF1 requires K1_INDEXER_FACTOR=1 or 4" >&2; return 1 ;; esac
PF1_SOURCE_OVERLAY=${PF1_SOURCE_OVERLAY:-offload/prefill_maxlen/generated/vllm/model_executor/layers/sparse_attn_indexer.py}
case "$PF1_SOURCE_OVERLAY" in *[[:space:]]*) echo "PF1 overlay path cannot contain whitespace" >&2; return 1 ;; esac
PF1_OVERLAY_SHA=$(sha256sum -- "$PF1_SOURCE_OVERLAY") || return 1
[ "${PF1_OVERLAY_SHA%% *}" = 1663d82cfa842a93b47e27cf942bd8bb9ceb65fe88763c3c953fdc6466a50ffd ] || { echo "PF1 overlay SHA mismatch" >&2; return 1; }
LABEL=PF1-${MAX_LEN_OVERRIDE}-views${PF1_WORKSPACE}-factor${K1_INDEXER_FACTOR}
OVERLAYS="$OVERLAYS $PF1_SOURCE_OVERLAY=/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/sparse_attn_indexer.py"
EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_DSV41_INDEXER_REQUEST_WORKSPACE=$PF1_WORKSPACE"
