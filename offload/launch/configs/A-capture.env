# Production settings + the DSpark capture overlay (rank 0 saves drafter inputs/outputs for lane O2's parity check).
# Not a benchmark configuration: the capture copies tensors to the host every round.
LABEL=A-capture
OVERLAYS="offload/dspark/capture/speculator.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/dspark/speculator.py"
EXP_DOCKER_ENV="VLLM_DSPARK_CAPTURE_DIR=/root/.cache/dspark-captures VLLM_DSPARK_CAPTURE_MAX_ROUNDS=600 VLLM_DSPARK_CAPTURE_TAPS_MAX_TOKENS=64"
