# DSV41-OFFLOAD lane O3: remote DSpark, SHADOW policy (parity; production drafts unchanged).
# The local drafter runs every round and its drafts are used. The x86host worker gets the same rows; its proposals are
# compared and logged on rank 0 (/tmp/dsv41-remote-dspark.json inside the container). Not a timing configuration:
# the local and the remote drafter both run every round.
# Before starting: lane O2's worker (ofl server, service dspark-v1) on 10.202.28.1:18620; libofl.so + ofl.py in
# ~/dsv41-offload-run/ofl on both nodes (INTEGRATION.md 1.3). o1tcp:// = ofl's TCP backend (debugging).
LABEL=C-shadow
OVERLAYS="offload/dspark/spark/remote_dspark=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/remote_dspark offload/dspark/spark/overlay/vllm/v1/worker/gpu/spec_decode/__init__.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/__init__.py"
EXTRA_DOCKER_ARGS="-v \$HOME/dsv41-offload-run/ofl:/opt/dsv41-ofl:ro"
EXP_DOCKER_ENV="VLLM_DSPARK_REMOTE=o1rdma://10.202.28.1:18620 VLLM_DSPARK_REMOTE_BIND=10.202.28.2 VLLM_DSPARK_REMOTE_OFL_DIR=/opt/dsv41-ofl VLLM_DSPARK_REMOTE_POLICY=shadow VLLM_DSPARK_REMOTE_IDENTITY=be2c1436fa9f9e66b398e1b1da2e140e6fddc82a11939e2ac4240a0ca79543bd VLLM_DSPARK_REMOTE_MARKOV_IDENTITY=0b6e71e638abd5abce2db433965bb5ff523cbbe92ed7ae54324a50ccaeffa19a VLLM_DSPARK_REMOTE_TIMEOUT_MS=50 VLLM_DSPARK_REMOTE_LOG_EVERY=256"
