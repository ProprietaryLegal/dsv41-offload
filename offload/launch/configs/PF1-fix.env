# PF1-CAUSE2 coordinator-only fix arm (source from the experiment checkout root, like start_exp.sh). No service starts here.
# Exactly PF1-window.env's OFF arm (sourced unchanged: production's own env and read-only mounts, cap; PF1_TRACE must be
# 0: no trace runtime, no spans, no trace directory), plus:
#  - the fence sources (offload/prefill_cause2, hash-checked against its OVERLAY.sha256) replace K1's nvidia/model.py,
#    vllm_exl3_moe/tf_prompt.py and tf_experts.py mounts once and add their helper (dsv41_moe_fence.py);
#  - VLLM_DSV41_MOE_FENCE=1: CUDA timing-event records at the PF1-CAUSE span positions of the MoE half, never read.
case "${PF1_TRACE-0}" in 0) ;; *) echo 'PF1 FIX STOP: the fix arm is untraced (PF1_TRACE must be 0)' >&2; return 1 ;; esac
. offload/launch/configs/PF1-window.env || return 1
case " $EXP_DOCKER_ENV " in *" VLLM_DSV41_MOE_FENCE="*) echo 'PF1 FIX STOP: production already sets VLLM_DSV41_MOE_FENCE' >&2; return 1 ;; esac
PF1F_ROOT=${PF1F_ROOT-offload/prefill_cause2/generated}
case "$PF1F_ROOT" in *[[:space:]]*|'') echo 'PF1 FIX STOP: fence source path empty or contains whitespace' >&2; return 1 ;; esac
pf1f_pins=$PWD/offload/prefill_cause2/OVERLAY.sha256
(cd "$PF1F_ROOT" && sha256sum --quiet -c "$pf1f_pins") || { echo 'PF1 FIX STOP: fence sources differ from OVERLAY.sha256' >&2; return 1; }
pf1f_lib=/usr/local/lib/python3.12/dist-packages
pf1f_targets=" $pf1f_lib/vllm/models/deepseek_v41/nvidia/model.py $pf1f_lib/vllm_exl3_moe/tf_prompt.py $pf1f_lib/vllm_exl3_moe/tf_experts.py "
read -r -a pf1f_tokens <<< "$EXTRA_DOCKER_ARGS"
pf1f_kept= pf1f_dropped=0 pf1f_i=0
while [ "$pf1f_i" -lt "${#pf1f_tokens[@]}" ]; do
  [ "${pf1f_tokens[$pf1f_i]}" = -v ] && [ $((pf1f_i + 1)) -lt "${#pf1f_tokens[@]}" ] \
    || { echo "PF1 FIX STOP: docker args are not '-v SRC:DST:MODE' pairs" >&2; return 1; }
  pf1f_spec=${pf1f_tokens[$((pf1f_i + 1))]}
  pf1f_dst=${pf1f_spec%:*}; pf1f_dst=${pf1f_dst#*:}
  case "$pf1f_targets" in
    *" $pf1f_dst "*) case "$pf1f_spec" in *:ro) pf1f_dropped=$((pf1f_dropped + 1)) ;;
                       *) echo "PF1 FIX STOP: $pf1f_dst is not a read-only production mount" >&2; return 1 ;; esac ;;
    *) pf1f_kept="${pf1f_kept:+$pf1f_kept }-v $pf1f_spec" ;;
  esac
  pf1f_i=$((pf1f_i + 2))
done
[ "$pf1f_dropped" = 3 ] || { echo "PF1 FIX STOP: expected exactly three production MoE targets, found $pf1f_dropped" >&2; return 1; }
EXTRA_DOCKER_ARGS=$pf1f_kept
while read -r pf1f_sha pf1f_path; do
  case " $OVERLAYS " in *"=$pf1f_lib/$pf1f_path "*) echo "PF1 FIX STOP: $pf1f_path is already overlaid" >&2; return 1 ;; esac
  OVERLAYS="${OVERLAYS:+$OVERLAYS }$PF1F_ROOT/$pf1f_path=$pf1f_lib/$pf1f_path"
done < "$pf1f_pins"
EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_DSV41_MOE_FENCE=1"
LABEL=PF1-fix-$PF1_CAP-fence1
unset pf1f_pins pf1f_lib pf1f_targets pf1f_tokens pf1f_kept pf1f_dropped pf1f_i pf1f_spec pf1f_dst pf1f_sha pf1f_path
