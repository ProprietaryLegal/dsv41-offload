# B: production settings + remote Engram rows from x86host's RAM over each Spark's direct RDMA link (lane O1).
# Needs: x86host engram_server up (engram_ctl.sh status), overlay staged (offload/engram/spark/stage_overlay.sh spark sparkworker),
# JIT ext prebuilt (offload/engram/INTEGRATION.md step 2). Local disk reader stays as the exact fallback.
LABEL=B-remote-engram
EXP_DOCKER_ENV="PYTHONPATH=/root/.cache/dsv41-offload/offload/engram/spark/py DSV41_ENGRAM_OVERLAY=/root/.cache/dsv41-offload/offload/engram/spark/engram.py VLLM_ENGRAM_REMOTE_ROOT=/root/.cache/dsv41-offload VLLM_ENGRAM_REMOTE=rdma://10.202.28.1:18610@10.202.28.2,rdma://10.202.29.1:18610@10.202.29.2 VLLM_ENGRAM_REMOTE_TIMEOUT_MS=100 VLLM_ENGRAM_REMOTE_RETRY_MS=5000 VLLM_ENGRAM_REMOTE_REQUIRED=1 VLLM_ENGRAM_REMOTE_LOG_S=60"
