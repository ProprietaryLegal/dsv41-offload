# Reviewed LOW-CAP derivative. Only replay/audit vary; no production worker change.
# Ledger: sparkhead main21bed31, prod-k1-327-20261023; x86host current fb68c52.
# Refuse inherited K1 overrides rather than silently replacing a selected profile.
for up2_pin in K1_KV_PAIR:3 K1_DROP_MTP:1 K1_TF_TRANSIENT:1 K1_TF_ALIAS:1 K1_INDEXER_FACTOR:4 K1_KV_BYTES:6442450944 UP2_CAP:327680; do
  up2_key=${up2_pin%%:*}; up2_value=${up2_pin#*:}
  if [ "${!up2_key-$up2_value}" != "$up2_value" ]; then
    echo "UP2 LOW STOP: $up2_key must equal $up2_value" >&2; return 1
  fi
done
[ -z "${K1_MEMPROBE-}${K1_NODROP-}${SPEC_OVERRIDE-}${EXP_EXTRA_ARGS-}" ] || {
  echo 'UP2 LOW STOP: unreviewed instrumentation/spec/extra arguments' >&2; return 1;
}
source offload/launch/configs/UP2-0075.env
MAX_LEN_OVERRIDE=327680
UP2_PROD_COMMIT=21bed31
UP2_PROD_TAG=prod-k1-327-20261023
UP2_WORKER_COMMIT=fb68c5291792ab90c0f468bd94010917967799f3
UP2_WORKER_TP=2
UP2_WORKER_MAX_LEN=1048576
# These are production's existing defaults, now explicit for arm comparison.
EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_DSPARK_REMOTE_ASYNC_RESPAWNS=3 VLLM_DSPARK_REMOTE_ASYNC_RESPAWN_RESET_S=3600"
LABEL=UP2-low-k1-replay${UP2_REPLAY}-audit${UP2_AUDIT}
