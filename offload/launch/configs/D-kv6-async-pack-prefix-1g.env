# RP1 Stage A: packed prefixes to CPU + local SSD.
# Generated by offload/kvpack/make_configs.py from D-kv6-async-process-nap-lazy.env + the K1 overlay (offload/kvpack, MANIFEST.json).
# Before the first start on a node: offload/kvpack/stage_overlay.sh check spark sparkworker (image base == overlay base).
# K1 switches (override at start; empty = off). Without the overlay mounted none of them exists in the image.
K1_KV_PAIR=${K1_KV_PAIR-3}            # KV page packing: 3 = 0060 (three 64-state pages), 1 = 0057; empty = v5 layout
K1_DROP_MTP=${K1_DROP_MTP-1}            # 0076b: no [4096, 20480] bf16 MTP residual buffer (160 MiB/rank, never read by DSpark)
K1_TF_TRANSIENT=${K1_TF_TRANSIENT-1}    # 0076d: TensorFold prompt scratch per MoE call instead of 1,014 MiB/rank held
K1_TF_ALIAS=${K1_TF_ALIAS-1}            # 0076e (with 0076d): down partials in the rotated rows' storage, call peak 1,014 -> 750 MiB
K1_INDEXER_FACTOR=${K1_INDEXER_FACTOR-4} # indexer prefill K-gather workspace factor (image default 8); empty = 8
K1_MEMPROBE=${K1_MEMPROBE-}             # 0076a: per-step memory JSONL prefix /root/.cache/dsv41-memprobe-<run>; empty = off
# memprobe opens <prefix>_r<rank>.jsonl and creates no directory: the prefix must sit directly in /root/.cache
# (= ~/.cache/dsv41-serve on each node, mounted by the launcher), or the worker dies at its first dummy step.
case "$K1_MEMPROBE" in "") ;; /root/.cache/*/*|/root/.cache/) echo "K1_MEMPROBE=$K1_MEMPROBE: use /root/.cache/<name> (no subdirectory)" >&2; return 1 ;; /root/.cache/*) ;; *) echo "K1_MEMPROBE=$K1_MEMPROBE: must start with /root/.cache/" >&2; return 1 ;; esac
K1_NODROP=${K1_NODROP-}                # disable_eagle_block_drop: NO effect in our serve (S8 N-4: with swa_bounded_replay the
#                                         flagged SWA group is not prefix-cacheable, so the drop never applies); a switch only
LABEL=D-kv6-async-pack-prefix-1g
KV_BYTES_OVERRIDE=${K1_KV_BYTES-6442450944}   # 6 GiB/rank; K1_KV_BYTES=1610612736 (1.5 GiB) = pool-pressure run R1b
if [ -n "$K1_NODROP" ]; then SPEC_OVERRIDE='{"method":"dspark","num_speculative_tokens":5,"num_speculative_tokens_per_batch_size":[[1,2,5],[3,4,4]],"disable_eagle_block_drop":true}'; fi
OVERLAYS="offload/dspark/spark/remote_dspark=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/remote_dspark offload/dspark/spark/overlay/vllm/v1/worker/gpu/spec_decode/__init__.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/__init__.py offload/kvpack/overlay/vllm/models/deepseek_v41/attention.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/attention.py offload/kvpack/overlay/vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py offload/kvpack/overlay/vllm/models/deepseek_v41/common/ops/nvfp4_fi_cache.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/common/ops/nvfp4_fi_cache.py offload/kvpack/overlay/vllm/models/deepseek_v41/nvidia/dspark.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/dspark.py offload/kvpack/overlay/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py offload/kvpack/overlay/vllm/models/deepseek_v41/nvidia/model.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/model.py offload/kvpack/overlay/vllm/v1/core/kv_cache_utils.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/core/kv_cache_utils.py offload/kvpack/overlay/vllm/v1/kv_cache_interface.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/kv_cache_interface.py offload/kvpack/overlay/vllm/v1/worker/utils.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/utils.py offload/kvpack/overlay/vllm/v1/worker/gpu/model_runner.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/model_runner.py offload/kvpack/overlay/vllm/v1/worker/gpu/dsv41_memprobe.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/dsv41_memprobe.py offload/kvpack/overlay/vllm_exl3_moe/tf_prompt.py=/usr/local/lib/python3.12/dist-packages/vllm_exl3_moe/tf_prompt.py offload/kvpack/overlay/vllm_exl3_moe/tf_experts.py=/usr/local/lib/python3.12/dist-packages/vllm_exl3_moe/tf_experts.py"
EXTRA_DOCKER_ARGS="-v \$HOME/dsv41-offload-run/ofl:/opt/dsv41-ofl:ro"
EXP_DOCKER_ENV="VLLM_DSPARK_REMOTE=o1rdma://10.202.28.1:18620 VLLM_DSPARK_REMOTE_BIND=10.202.28.2 VLLM_DSPARK_REMOTE_OFL_DIR=/opt/dsv41-ofl VLLM_DSPARK_REMOTE_POLICY=capacity VLLM_DSPARK_REMOTE_ASYNC=1 VLLM_DSPARK_REMOTE_ASYNC_PROXY=process VLLM_DSPARK_REMOTE_BACKOFF_MAX_MS=5000 VLLM_DSPARK_REMOTE_ASYNC_SPIN_US=50 VLLM_DSPARK_REMOTE_ASYNC_NAP_US=20 VLLM_DSPARK_REMOTE_IDENTITY=be2c1436fa9f9e66b398e1b1da2e140e6fddc82a11939e2ac4240a0ca79543bd VLLM_DSPARK_REMOTE_MARKOV_IDENTITY=0b6e71e638abd5abce2db433965bb5ff523cbbe92ed7ae54324a50ccaeffa19a VLLM_DSPARK_REMOTE_TIMEOUT_MS=50 VLLM_DSPARK_REMOTE_ROUND_MS=28.79,31.86,34.44,37.76,41.56,43.68 VLLM_DSPARK_REMOTE_DRAFT_MS=4.4 VLLM_DSPARK_REMOTE_LOG_EVERY=1024 PYTHONPATH=/root/.cache/dsv41-offload/offload/engram/spark/py DSV41_ENGRAM_OVERLAY=/root/.cache/dsv41-offload/offload/engram/spark/engram.py VLLM_ENGRAM_REMOTE_ROOT=/root/.cache/dsv41-offload VLLM_ENGRAM_REMOTE=rdma://10.202.28.1:18610@10.202.28.2,rdma://10.202.29.1:18610@10.202.29.2 VLLM_ENGRAM_REMOTE_TIMEOUT_MS=100 VLLM_ENGRAM_REMOTE_RETRY_MS=5000 VLLM_ENGRAM_REMOTE_REQUIRED=1 VLLM_ENGRAM_REMOTE_LOG_S=60${K1_KV_PAIR:+ VLLM_DSV41_KV_PAIR=$K1_KV_PAIR}${K1_DROP_MTP:+ VLLM_DSV41_DROP_MTP_BUFFER=$K1_DROP_MTP}${K1_TF_TRANSIENT:+ VLLM_EXL3_TF_PROMPT_TRANSIENT=$K1_TF_TRANSIENT}${K1_TF_ALIAS:+ VLLM_EXL3_TF_PROMPT_ALIAS=$K1_TF_ALIAS}${K1_INDEXER_FACTOR:+ VLLM_INDEXER_PREFILL_BUFFER_FACTOR=$K1_INDEXER_FACTOR}${K1_MEMPROBE:+ VLLM_DSV41_MEMPROBE=$K1_MEMPROBE VLLM_DSV41_MEMPROBE_LAYERS=2,14,20}"
OVERLAYS="$OVERLAYS offload/prefixstore/overlay/vllm/config/vllm.py=/usr/local/lib/python3.12/dist-packages/vllm/config/vllm.py offload/prefixstore/overlay/vllm/distributed/kv_transfer/kv_connector/v1/offloading/config.py=/usr/local/lib/python3.12/dist-packages/vllm/distributed/kv_transfer/kv_connector/v1/offloading/config.py offload/prefixstore/overlay/vllm/distributed/kv_transfer/kv_connector/v1/offloading/worker.py=/usr/local/lib/python3.12/dist-packages/vllm/distributed/kv_transfer/kv_connector/v1/offloading/worker.py offload/prefixstore/overlay/vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py=/usr/local/lib/python3.12/dist-packages/vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py offload/prefixstore/overlay/vllm/v1/kv_offload/tiering/fs/io.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/tiering/fs/io.py offload/prefixstore/overlay/vllm/v1/kv_offload/tiering/fs/manager.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/tiering/fs/manager.py offload/prefixstore/overlay/vllm/v1/kv_offload/tiering/fs/thread_pool.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/tiering/fs/thread_pool.py"
# RP1 coordinator-only candidate. PREFIX_ENABLE=0 gives the same-overlay no-connector control.
PREFIX_ENABLE=${PREFIX_ENABLE-1}
PREFIX_CPU_BYTES=${PREFIX_CPU_BYTES-1073741824}
PREFIX_LOAD_FRACTION=${PREFIX_LOAD_FRACTION-0.2} # four requests x .2, leaving 20% for stores/in-flight promotions
PREFIX_IO_CPUS=${PREFIX_IO_CPUS-0-4,10-13} # verify A725 topology/allowed CPUs before use
PREFIX_MN_VERIFY=${PREFIX_MN_VERIFY-0}    # diagnostic: both ranks store for byte comparison
if [ "$PREFIX_ENABLE" = 1 ]; then
  PREFIX_MODEL_SHA256=${PREFIX_MODEL_SHA256:?SHA256 of exact checkpoint manifest required (not model path)}
  case "$PREFIX_MODEL_SHA256" in *[!0-9a-f]*) echo "PREFIX_MODEL_SHA256 must be lowercase SHA256" >&2; return 1;; esac
  [ "${#PREFIX_MODEL_SHA256}" = 64 ] || { echo "PREFIX_MODEL_SHA256 must be 64 hex characters" >&2; return 1; }
  case "$PREFIX_CPU_BYTES" in ''|*[!0-9]*) echo "PREFIX_CPU_BYTES must be positive bytes" >&2; return 1;; esac
  [ "$PREFIX_CPU_BYTES" -ge 16777216 ] && [ "$PREFIX_CPU_BYTES" -le 2147483648 ] || { echo "PREFIX_CPU_BYTES outside 16MiB..2GiB" >&2; return 1; }
  case "$PREFIX_LOAD_FRACTION" in 0.05|0.1|0.15|0.2) ;; *) echo "four-request load fraction must be .05/.1/.15/.2 (with leading zero)" >&2; return 1;; esac
  case "$PREFIX_IO_CPUS" in ''|*[!0-9,-]*) echo "PREFIX_IO_CPUS must be an explicit CPU list" >&2; return 1;; esac
  case "$PREFIX_MN_VERIFY" in 0|1) ;; *) echo "PREFIX_MN_VERIFY must be 0 or 1" >&2; return 1;; esac
  PREFIX_TRANSFER_JSON="{\"kv_connector\":\"OffloadingConnector\",\"kv_role\":\"kv_both\",\"kv_connector_extra_config\":{\"spec_name\":\"TieringOffloadingSpec\",\"cpu_bytes_to_use\":$PREFIX_CPU_BYTES,\"prefix_store_identity\":{\"checkpoint_sha256\":\"$PREFIX_MODEL_SHA256\",\"layout_sha256\":\"7010a92d4c7cb14d5c9782510e8b9326f30aa81b21576cfd019cca0a3d40c191\"},\"secondary_tiers\":[{\"type\":\"fs\",\"root_dir\":\"/root/.cache/kv_prefix_rp1\",\"n_read_threads\":2,\"n_write_threads\":1}]}}"
  EXP_EXTRA_ARGS="${EXP_EXTRA_ARGS:+$EXP_EXTRA_ARGS }--kv-transfer-config '$PREFIX_TRANSFER_JSON'"
  EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_DSV41_KV_CRC=1 VLLM_DSV41_OFFLOAD_EXPANDABLE_OK=1 VLLM_DSV41_OFFLOAD_MULTINODE=1 VLLM_DSV41_OFFLOAD_MN_VERIFY=$PREFIX_MN_VERIFY VLLM_DSV41_OFFLOAD_MN_STAGE_MB=8 VLLM_DSV41_OFFLOAD_LOAD_FRACTION=$PREFIX_LOAD_FRACTION VLLM_DSV41_OFFLOAD_IO_CPUS=$PREFIX_IO_CPUS"
elif [ "$PREFIX_ENABLE" != 0 ]; then
  echo "PREFIX_ENABLE must be 0 or 1" >&2; return 1
fi
