# NBW coordinator experiment. Source from the experiment root; production is read-only.
# K preserves today's production env/mounts verbatim. I changes ONLY the two drafter identities.
# No PF1 REQUIRED override, trace overlay, policy/cap/KV change or build is permitted.
for nbw_key in K1_KV_PAIR K1_DROP_MTP K1_TF_TRANSIENT K1_TF_ALIAS K1_INDEXER_FACTOR K1_KV_BYTES K1_MEMPROBE K1_NODROP \
    SPEC_OVERRIDE EXP_EXTRA_ARGS OVERLAYS EXTRA_DOCKER_ARGS EXP_DOCKER_ENV KV_BYTES_OVERRIDE MAX_LEN_OVERRIDE; do
  if [ -n "${!nbw_key-}" ]; then echo "NBW STOP: inherited $nbw_key" >&2; return 1; fi
done
NBW_ROLE=${NBW_ROLE-K}
case "$NBW_ROLE" in K|I) ;; *) echo 'NBW STOP: role must be K or I' >&2; return 1 ;; esac
NBW_PROD_ENV=${NBW_PROD_ENV-$HOME/dsv41-deploy/dsv41.env}
[ -f "$NBW_PROD_ENV" ] || { echo 'NBW STOP: production env missing' >&2; return 1; }
nbw_prod=$(set +u; . "$NBW_PROD_ENV" >/dev/null || exit 1
  printf '%s\n' "${OFFLOAD_DOCKER_ENV-}" "${OFFLOAD_DSPARK_ENV-}" "${OFFLOAD_DOCKER_ARGS-}" \
    "${PROD_KV_BYTES-}" "${PROD_MAX_LEN-}" "${PROD_K1-}" "${PROD_K1_PROFILE-}") || return 1
mapfile -t nbw_lines <<< "$nbw_prod"
[ "${#nbw_lines[@]}" = 7 ] && [ "${nbw_lines[3]}:${nbw_lines[4]}:${nbw_lines[5]}:${nbw_lines[6]}" = 6442450944:327680:1:327680 ] \
  || { echo 'NBW STOP: production KV/cap/K1 ledger changed' >&2; return 1; }
nbw_env="${nbw_lines[0]} ${nbw_lines[1]}"
for nbw_need in VLLM_DSV41_KV_PAIR=3 VLLM_DSV41_DROP_MTP_BUFFER=1 VLLM_EXL3_TF_PROMPT_TRANSIENT=1 \
    VLLM_EXL3_TF_PROMPT_ALIAS=1 VLLM_INDEXER_PREFILL_BUFFER_FACTOR=4 VLLM_DSPARK_REMOTE_POLICY=capacity \
    VLLM_DSPARK_REMOTE_ASYNC=1 VLLM_DSPARK_REMOTE_ASYNC_PROXY=process; do
  case " $nbw_env " in *" $nbw_need "*) ;; *) echo "NBW STOP: production lacks $nbw_need" >&2; return 1 ;; esac
done
if [ "$NBW_ROLE" = I ]; then
  for nbw_key in VLLM_DSPARK_REMOTE_IDENTITY VLLM_DSPARK_REMOTE_MARKOV_IDENTITY; do
    case "$nbw_key" in
      VLLM_DSPARK_REMOTE_IDENTITY) nbw_value=${NBW_NATIVE_IDENTITY-} ;;
      *) nbw_value=${NBW_NATIVE_MARKOV_IDENTITY-} ;;
    esac
    [[ "$nbw_value" =~ ^[0-9a-f]{64}$ ]] || { echo "NBW STOP: reviewed $nbw_key required" >&2; return 1; }
    read -r -a nbw_tokens <<< "$nbw_env"
    nbw_count=0 nbw_env=
    for nbw_token in "${nbw_tokens[@]}"; do
      case "$nbw_token" in "$nbw_key="*) nbw_token="$nbw_key=$nbw_value"; nbw_count=$((nbw_count + 1)) ;; esac
      nbw_env="${nbw_env:+$nbw_env }$nbw_token"
    done
    [ "$nbw_count" = 1 ] || { echo "NBW STOP: expected one production $nbw_key" >&2; return 1; }
  done
fi
MAX_LEN_OVERRIDE=${nbw_lines[4]}
KV_BYTES_OVERRIDE=${nbw_lines[3]}
EXP_DOCKER_ENV=$nbw_env
EXTRA_DOCKER_ARGS=${nbw_lines[2]}
OVERLAYS=
LABEL=NBW-native-$NBW_ROLE
unset nbw_key nbw_prod nbw_lines nbw_env nbw_need nbw_value nbw_tokens nbw_count nbw_token
