# N4 online64 attention / FP32 base-Markov-sum. V1/pair qualification required; see N4 report.
# Synchronous native control; same weights/identity/capacity as matching async arm.
# native-packed; draft head target-shared EXL3 K6. Requires matching DSPARK_WORKER_ARM.
# Timing values inherited for screening ONLY; recalibrate per N3 README before policy promotion.
# D-kv6-async-process-nap with CUDA_MODULE_LOADING left at LAZY (window-4 primary async arm, coordinator 2026-10-23).
# EAGER costs ~18 min per serve start (1,456 s vs ~363 s, E0-eager) and is not the async TTFT cause; with the process proxy
# a module load behind a parked stream waits one round instead of deadlocking (ORDERING.md §2), and the engine C watchdog
# still bounds any park. Otherwise identical to D-kv6-async-process-nap (proxy naps after 50 us of spinning, 20 us naps).
# Pass checks: 'remote DSpark async mode on (host-flag hand-off self-test passed', 'remote DSpark proxy process running',
# 'through proxy process pid'; stats: async_proxy.mode process, proxy_torch_loaded false, async_watchdog.fires ~0,
# watchdog_preempted 0 (S11 P-1 exposure otherwise).
OVERLAYS="offload/dspark/spark/remote_dspark=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/remote_dspark offload/dspark/spark/overlay/vllm/v1/worker/gpu/spec_decode/__init__.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/__init__.py"
EXTRA_DOCKER_ARGS="-v \$HOME/dsv41-offload-run/ofl:/opt/dsv41-ofl:ro"
EXP_DOCKER_ENV="VLLM_DSPARK_REMOTE=o1rdma://10.202.28.1:18620 VLLM_DSPARK_REMOTE_BIND=10.202.28.2 VLLM_DSPARK_REMOTE_OFL_DIR=/opt/dsv41-ofl VLLM_DSPARK_REMOTE_POLICY=capacity VLLM_DSPARK_REMOTE_ASYNC=0 VLLM_DSPARK_REMOTE_ASYNC_PROXY=process VLLM_DSPARK_REMOTE_BACKOFF_MAX_MS=5000 VLLM_DSPARK_REMOTE_ASYNC_SPIN_US=50 VLLM_DSPARK_REMOTE_ASYNC_NAP_US=20 VLLM_DSPARK_REMOTE_IDENTITY=44afbb19fa016f2267ff0ff03678b13fb70d5152ebf08938ebd5f9c7a7fc08ed VLLM_DSPARK_REMOTE_MARKOV_IDENTITY=0b6e71e638abd5abce2db433965bb5ff523cbbe92ed7ae54324a50ccaeffa19a VLLM_DSPARK_REMOTE_TIMEOUT_MS=50 VLLM_DSPARK_REMOTE_ROUND_MS=28.79,31.86,34.44,37.76,41.56,43.68 VLLM_DSPARK_REMOTE_DRAFT_MS=4.4 VLLM_DSPARK_REMOTE_LOG_EVERY=1024 PYTHONPATH=/root/.cache/dsv41-offload/offload/engram/spark/py DSV41_ENGRAM_OVERLAY=/root/.cache/dsv41-offload/offload/engram/spark/engram.py VLLM_ENGRAM_REMOTE_ROOT=/root/.cache/dsv41-offload VLLM_ENGRAM_REMOTE=rdma://10.202.28.1:18610@10.202.28.2,rdma://10.202.29.1:18610@10.202.29.2 VLLM_ENGRAM_REMOTE_TIMEOUT_MS=100 VLLM_ENGRAM_REMOTE_RETRY_MS=5000 VLLM_ENGRAM_REMOTE_REQUIRED=1 VLLM_ENGRAM_REMOTE_LOG_S=60"
