# PF1-WINDOW coordinator-only experiment (source from the experiment checkout root, like start_exp.sh). No service starts here.
# OFF (PF1_TRACE=0) is today's production launch: production's own OFFLOAD_DOCKER_ENV + OFFLOAD_DSPARK_ENV and its read-only
# OFFLOAD_DOCKER_ARGS mounts (K1 559c5867, remote_dspark, spec_decode/__init__.py, ofl), read from the production checkout's
# dsv41.env in a subshell: nothing copied, nothing written there. The experiment checkout's own remote_dspark drifted from
# production (PF1-WINDOW-RECONCILE.md), so it is never mounted. Differences from production: port 8001 (start_exp.sh),
# max_model_len PF1_CAP, VLLM_ENGRAM_REMOTE_REQUIRED=1 on every arm (no silent local Engram fallback), label.
# ON (PF1_TRACE=1): K1's two trace targets are replaced once by the hash-checked PF1-R2 sources (+ 3 image-file spans and the
# helper), plus the trace env and a per-run writable trace directory. PF1_EAGER=1 adds --enforce-eager (matched contingency).
for pf1_unset in K1_KV_PAIR K1_DROP_MTP K1_TF_TRANSIENT K1_TF_ALIAS K1_INDEXER_FACTOR K1_KV_BYTES K1_MEMPROBE K1_NODROP \
    SPEC_OVERRIDE EXP_EXTRA_ARGS OVERLAYS EXTRA_DOCKER_ARGS EXP_DOCKER_ENV KV_BYTES_OVERRIDE MAX_LEN_OVERRIDE; do
  if [ -n "${!pf1_unset-}" ]; then echo "PF1 WINDOW STOP: inherited $pf1_unset is not part of this window" >&2; return 1; fi
done
PF1_CAP=${PF1_CAP-327680}
case "$PF1_CAP" in 327680|524288) ;; *) echo "PF1 WINDOW STOP: PF1_CAP must be 327680 or 524288" >&2; return 1 ;; esac
PF1_TRACE=${PF1_TRACE-0}
case "$PF1_TRACE" in 0|1) ;; *) echo "PF1 WINDOW STOP: PF1_TRACE must be 0 or 1" >&2; return 1 ;; esac
PF1_EAGER=${PF1_EAGER-0}
case "$PF1_EAGER" in 0|1) ;; *) echo "PF1 WINDOW STOP: PF1_EAGER must be 0 or 1" >&2; return 1 ;; esac
PF1_PROD_ENV=${PF1_PROD_ENV-$HOME/dsv41-deploy/dsv41.env}
[ -f "$PF1_PROD_ENV" ] || { echo "PF1 WINDOW STOP: production config $PF1_PROD_ENV missing" >&2; return 1; }
# Subshell: production's assignments (PORT=8000, HEAD, IMAGE ...) never reach this experiment's environment.
pf1_prod=$(set +u; . "$PF1_PROD_ENV" >/dev/null 2>&1 || exit 1
  printf '%s\n' "${OFFLOAD_DOCKER_ENV-}" "${OFFLOAD_DSPARK_ENV-}" "${OFFLOAD_DOCKER_ARGS-}" \
    "${PROD_KV_BYTES-}" "${PROD_MAX_LEN-}" "${PROD_K1-}" "${PROD_K1_PROFILE-}") \
  || { echo "PF1 WINDOW STOP: production config did not source" >&2; return 1; }
mapfile -t pf1_lines <<< "$pf1_prod"
[ "${#pf1_lines[@]}" = 7 ] || { echo "PF1 WINDOW STOP: production config shape changed" >&2; return 1; }
pf1_docker_env=${pf1_lines[0]} pf1_dspark_env=${pf1_lines[1]} pf1_args=${pf1_lines[2]}
# The reconciled production ledger (21bed31): any other value means production changed; re-reconcile, never adapt silently.
[ "${pf1_lines[3]}:${pf1_lines[4]}:${pf1_lines[5]}:${pf1_lines[6]}" = 6442450944:327680:1:327680 ] \
  || { echo "PF1 WINDOW STOP: production KV/cap/K1 profile differs from the reconciled ledger" >&2; return 1; }
for pf1_need in VLLM_DSV41_KV_PAIR=3 VLLM_DSV41_DROP_MTP_BUFFER=1 VLLM_EXL3_TF_PROMPT_TRANSIENT=1 VLLM_EXL3_TF_PROMPT_ALIAS=1 \
    VLLM_INDEXER_PREFILL_BUFFER_FACTOR=4 VLLM_ENGRAM_REMOTE_REQUIRED=0; do
  case " $pf1_docker_env " in *" $pf1_need "*) ;; *) echo "PF1 WINDOW STOP: production env lacks $pf1_need" >&2; return 1 ;; esac
done
for pf1_need in VLLM_DSPARK_REMOTE_POLICY=capacity VLLM_DSPARK_REMOTE_ASYNC=1 VLLM_DSPARK_REMOTE_ASYNC_PROXY=process; do
  case " $pf1_dspark_env " in *" $pf1_need "*) ;; *) echo "PF1 WINDOW STOP: production drafter env lacks $pf1_need" >&2; return 1 ;; esac
done
pf1_target_runner=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/model_runner.py
pf1_target_sparse=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py
read -r -a pf1_tokens <<< "$pf1_args"
pf1_kept= pf1_dropped=0 pf1_i=0
while [ "$pf1_i" -lt "${#pf1_tokens[@]}" ]; do
  [ "${pf1_tokens[$pf1_i]}" = -v ] && [ $((pf1_i + 1)) -lt "${#pf1_tokens[@]}" ] \
    || { echo "PF1 WINDOW STOP: production docker args are not '-v SRC:DST:ro' pairs" >&2; return 1; }
  pf1_spec=${pf1_tokens[$((pf1_i + 1))]}
  case "$pf1_spec" in *:ro) ;; *) echo "PF1 WINDOW STOP: production mount $pf1_spec is not read-only" >&2; return 1 ;; esac
  pf1_dst=${pf1_spec%:ro}; pf1_dst=${pf1_dst#*:}
  if [ "$PF1_TRACE" = 1 ] && { [ "$pf1_dst" = "$pf1_target_runner" ] || [ "$pf1_dst" = "$pf1_target_sparse" ]; }; then
    pf1_dropped=$((pf1_dropped + 1))
  else
    pf1_kept="${pf1_kept:+$pf1_kept }-v $pf1_spec"
  fi
  pf1_i=$((pf1_i + 2))
done
pf1_env=" $pf1_docker_env "
pf1_rest=${pf1_env#* VLLM_ENGRAM_REMOTE_REQUIRED=}
case "$pf1_rest" in *" VLLM_ENGRAM_REMOTE_REQUIRED="*) echo 'PF1 WINDOW STOP: duplicate Engram REQUIRED setting' >&2; return 1 ;; esac
pf1_env=${pf1_env/ VLLM_ENGRAM_REMOTE_REQUIRED=0 / VLLM_ENGRAM_REMOTE_REQUIRED=1 }
pf1_env=${pf1_env# }; pf1_env=${pf1_env% }
MAX_LEN_OVERRIDE=$PF1_CAP
KV_BYTES_OVERRIDE=${pf1_lines[3]}
EXP_DOCKER_ENV="$pf1_env $pf1_dspark_env"
EXTRA_DOCKER_ARGS=$pf1_kept
OVERLAYS=
LABEL=PF1-window-$PF1_CAP-trace$PF1_TRACE-eager$PF1_EAGER
if [ "$PF1_TRACE" = 1 ]; then
  [ "$pf1_dropped" = 2 ] || { echo "PF1 WINDOW STOP: expected exactly two production trace targets, found $pf1_dropped" >&2; return 1; }
  : "${PF1_TRACE_RUN:?unique public window id required}"
  case "$PF1_TRACE_RUN" in *[!a-zA-Z0-9_-]*|'') echo 'PF1 WINDOW STOP: invalid PF1_TRACE_RUN' >&2; return 1 ;; esac
  PF1_TRACE_ROOT=${PF1_TRACE_ROOT-offload/prefill_trace/generated}
  case "$PF1_TRACE_ROOT" in *[[:space:]]*|'') echo 'PF1 WINDOW STOP: trace source path empty or contains whitespace' >&2; return 1 ;; esac
  pf1_pins=$PWD/offload/prefill_trace/OVERLAY.sha256
  (cd "$PF1_TRACE_ROOT" && sha256sum --quiet -c "$pf1_pins") || { echo 'PF1 WINDOW STOP: trace sources differ from OVERLAY.sha256' >&2; return 1; }
  while read -r pf1_sha pf1_path; do
    OVERLAYS="${OVERLAYS:+$OVERLAYS }$PF1_TRACE_ROOT/$pf1_path=/usr/local/lib/python3.12/dist-packages/$pf1_path"
  done < "$pf1_pins"
  EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_DSV41_PREFILL_TRACE=1 VLLM_DSV41_PREFILL_TRACE_DIR=/pf1-trace VLLM_DSV41_PREFILL_TRACE_RUN=$PF1_TRACE_RUN"
  EXTRA_DOCKER_ARGS="$EXTRA_DOCKER_ARGS -v \$HOME/dsv41-offload-run/pf1-trace/$PF1_TRACE_RUN:/pf1-trace:rw"
elif [ "$pf1_dropped" != 0 ]; then
  echo 'PF1 WINDOW STOP: OFF arm dropped a production mount' >&2; return 1
fi
if [ "$PF1_EAGER" = 1 ]; then EXP_EXTRA_ARGS=--enforce-eager; fi
unset pf1_unset pf1_prod pf1_lines pf1_docker_env pf1_dspark_env pf1_args pf1_need pf1_tokens pf1_kept pf1_dropped pf1_i pf1_env pf1_rest \
  pf1_spec pf1_dst pf1_target_runner pf1_target_sparse pf1_pins pf1_sha pf1_path
