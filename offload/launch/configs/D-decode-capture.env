# Coordinator window only; exact production K1-327680 + tagged capture.
. offload/launch/configs/D-kv6-async-pack.env
LABEL=D-decode-capture
MAX_LEN_OVERRIDE=327680
KV_BYTES_OVERRIDE=6442450944
# These differ in the historical experiment base; match the production D profile.
EXP_DOCKER_ENV="${EXP_DOCKER_ENV/VLLM_ENGRAM_REMOTE_REQUIRED=1/VLLM_ENGRAM_REMOTE_REQUIRED=0} VLLM_DSPARK_REMOTE_ASYNC_RESPAWNS=3 VLLM_DSPARK_REMOTE_ASYNC_RESPAWN_RESET_S=3600 VLLM_DSPARK_DECODE_CAPTURE_DIR=/d2-decode"
OVERLAYS="$OVERLAYS offload/dspark/capture/speculator_replay.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/dspark/speculator.py offload/dspark/capture/decode_capture.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/dspark/decode_capture.py"
: "${D2_DECODE_RUN:?set a NEW smoke run ID and pre-create host-owned capture dirs on BOTH ranks}"
case "$D2_DECODE_RUN" in *[!A-Za-z0-9_-]*|'') echo 'unsafe D2_DECODE_RUN' >&2; return 1;; esac
EXTRA_DOCKER_ARGS="$EXTRA_DOCKER_ARGS -v \$HOME/dsv41-offload-run/d2-decode-$D2_DECODE_RUN:/d2-decode:rw"
