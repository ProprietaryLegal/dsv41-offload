# UP2 coordinator-only experiment wrapper; CPU source checks do not start services.
# All new controls OFF by default. Source from the repository root, like start_exp.sh.
UP2_CAP=${UP2_CAP-327680}
UP2_REPLAY=${UP2_REPLAY-0}
UP2_AUDIT=${UP2_AUDIT-0}
case "$UP2_CAP" in 327680|524288) ;; *) echo "invalid UP2_CAP=$UP2_CAP" >&2; return 1 ;; esac
case "$UP2_REPLAY" in 0|1) ;; *) echo "invalid UP2_REPLAY=$UP2_REPLAY" >&2; return 1 ;; esac
case "$UP2_AUDIT" in 0|1) ;; *) echo "invalid UP2_AUDIT=$UP2_AUDIT" >&2; return 1 ;; esac
UP1_SPLIT=0
UP1_VOR=0
UP1_REPLAY=$UP2_REPLAY
UP1_K5=0
UP1_DUAL_RING=0
UP1_CPU_PIN=0
source offload/launch/configs/D-kv6-async-up1-control.env
MAX_LEN_OVERRIDE=$UP2_CAP
LABEL=UP2-0075-cap${UP2_CAP}-replay${UP2_REPLAY}-audit${UP2_AUDIT}
EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_DSV41_REPLAY_AUDIT=$UP2_AUDIT"
