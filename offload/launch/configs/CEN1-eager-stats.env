# CEN1 coordinator experiment (eager distinct-expert count). Source from the experiment checkout root, like start_exp.sh.
# = NBW-native.env's K arm (production's OFFLOAD_DOCKER_ENV + OFFLOAD_DSPARK_ENV, read-only mounts, KV and cap from
# production's dsv41.env, verbatim) plus exactly these CEN1 additions (documents/plans/lanes/CEN-RUN.plan.md):
#   env  VLLM_EXL3_MOE_SMOE=0                     decode leaves exl3_smoe for the coop/fused path, the one that records
#        VLLM_EXL3_MOE_STATS=/cen1/moe-stats.jsonl  forward.py's per-pid summary line every 2,000 MoE calls
#        VLLM_DSPARK_DEPTH_POLICY=fixed:5           builds DSparkDepthPolicy (production leaves it off; the file alone is inert)
#        VLLM_DSPARK_DEPTH_FILE=/cen1/depth-policy  runner-written policy, re-read every 64 verify steps
#        AK_MAX_REQS=0 -> VLLM_DSV41_AK_MAX_REQS=0  0047's adaptive verify window off (it would narrow a fixed depth)
#   argv --enforce-eager                            the stats hook is Python: CUDA-graph replays record nothing
#   mount $HOME/dsv41-offload-run/cen1/<CEN1_TAG> -> /cen1 (rw), created by the runner before the start
# Counts only: eager timing is never reported as a speed. The runner (offload/launch/windows/cen1_window.py) passes
# CEN1_TAG; anything inherited that this file sets refuses.
for cen1_key in NBW_ROLE AK_MAX_REQS EXP_EXTRA_ARGS EXP_DOCKER_ENV EXTRA_DOCKER_ARGS; do
  if [ -n "${!cen1_key-}" ]; then echo "CEN1 STOP: inherited $cen1_key" >&2; return 1; fi
done
[[ "${CEN1_TAG-}" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]{0,95}$ ]] || { echo 'CEN1 STOP: CEN1_TAG (the window tag) required' >&2; return 1; }
NBW_ROLE=K
. offload/launch/configs/NBW-native.env || return 1
case " $EXP_DOCKER_ENV " in
  *" VLLM_EXL3_MOE_"*|*" VLLM_DSPARK_DEPTH_"*|*" VLLM_DSV41_AK_"*)
    echo 'CEN1 STOP: production env already names a CEN1 key' >&2; return 1 ;;
esac
case "$EXTRA_DOCKER_ARGS" in *:/cen1*) echo 'CEN1 STOP: base mounts already name /cen1' >&2; return 1 ;; esac
EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_EXL3_MOE_SMOE=0 VLLM_EXL3_MOE_STATS=/cen1/moe-stats.jsonl VLLM_DSPARK_DEPTH_POLICY=fixed:5 VLLM_DSPARK_DEPTH_FILE=/cen1/depth-policy"
EXP_EXTRA_ARGS=--enforce-eager
EXTRA_DOCKER_ARGS="$EXTRA_DOCKER_ARGS -v \$HOME/dsv41-offload-run/cen1/$CEN1_TAG:/cen1:rw"
AK_MAX_REQS=0
LABEL=CEN1-eager-stats
unset cen1_key
