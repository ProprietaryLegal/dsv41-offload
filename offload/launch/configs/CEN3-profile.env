# CEN3 part (b) coordinator experiment: one profiled production-config start. Source from the experiment checkout root.
# = NBW-native.env's K arm (production's OFFLOAD_DOCKER_ENV + OFFLOAD_DSPARK_ENV, read-only mounts, KV and cap from
# production's dsv41.env, verbatim) plus exactly two additions (documents/plans/lanes/CEN-RUN.plan.md, SP1's pattern):
#   argv  --profiler-config <JSON below>: torch profiler configured on both ranks, idle until POST /start_profile,
#         64 iterations a capture (SP1 used 16; CEN3 wants >= 50 target-only steps in one capture)
#   mount $HOME/dsv41-offload-run/cen3/<CEN3_TAG>/profile -> /cen3-profile (rw), created by the runner
# The runner (offload/launch/windows/cen3_window.py) passes CEN3_TAG and holds the byte-identical JSON (CPU test).
for cen3_key in NBW_ROLE EXP_EXTRA_ARGS EXP_DOCKER_ENV EXTRA_DOCKER_ARGS CEN3_PROFILER_CONFIG; do
  if [ -n "${!cen3_key-}" ]; then echo "CEN3 STOP: inherited $cen3_key" >&2; return 1; fi
done
[[ "${CEN3_TAG-}" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]{0,95}$ ]] || { echo 'CEN3 STOP: CEN3_TAG (the window tag) required' >&2; return 1; }
NBW_ROLE=K
. offload/launch/configs/NBW-native.env || return 1
case "$EXTRA_DOCKER_ARGS" in *:/cen3-profile*) echo 'CEN3 STOP: base mounts already name /cen3-profile' >&2; return 1 ;; esac
CEN3_PROFILER_CONFIG='{"profiler":"torch","torch_profiler_dir":"/cen3-profile","torch_profiler_activities":["CPU","CUDA"],"torch_profiler_with_stack":false,"torch_profiler_with_flops":false,"torch_profiler_record_shapes":false,"torch_profiler_with_memory":false,"torch_profiler_use_gzip":true,"torch_profiler_dump_cuda_time_total":false,"ignore_frontend":true,"detailed_trace_annotation":true,"max_iterations":64}'
EXP_EXTRA_ARGS="--profiler-config '$CEN3_PROFILER_CONFIG'"
EXTRA_DOCKER_ARGS="$EXTRA_DOCKER_ARGS -v \$HOME/dsv41-offload-run/cen3/$CEN3_TAG/profile:/cen3-profile:rw"
LABEL=CEN3-profile
unset cen3_key CEN3_PROFILER_CONFIG
