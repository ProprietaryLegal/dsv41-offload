# SP1-WINDOW coordinator-only profiling arm (source from the experiment checkout root, like start_exp.sh). No service starts here.
# = PF1-window.env's OFF arm at 327,680: production's own OFFLOAD_DOCKER_ENV + OFFLOAD_DSPARK_ENV and read-only mounts from
# production's dsv41.env, port 8001, VLLM_ENGRAM_REMOTE_REQUIRED=1 (offload/prefill_maxlen/PF1-WINDOW-RECONCILE.md). Exactly
# two additions (offload/gb10_budget/PROFILE-WINDOW-RECONCILE.md): --profiler-config (torch profiler configured on both ranks,
# idle until POST /start_profile) and the read-write trace directory $HOME/dsv41-offload-run/sp1-profile -> /sp1-profile.
# The runner (offload/launch/windows/sp1_window.py) passes PF1_CAP=327680 PF1_TRACE=0 PF1_EAGER=0; any other value refuses.
case "${PF1_CAP-327680}:${PF1_TRACE-0}:${PF1_EAGER-0}" in
  327680:0:0) ;;
  *) echo 'SP1 WINDOW STOP: the profiled arm is the 327,680 OFF arm only (PF1_CAP=327680 PF1_TRACE=0 PF1_EAGER=0)' >&2; return 1 ;;
esac
if [ -n "${PF1_TRACE_RUN-}${PF1_TRACE_ROOT-}${SP1_PROFILER_CONFIG-}" ]; then
  echo 'SP1 WINDOW STOP: inherited PF1 trace or SP1 profiler settings are not part of this window' >&2; return 1
fi
PF1_CAP=327680 PF1_TRACE=0 PF1_EAGER=0
. offload/launch/configs/PF1-window.env || return 1
[ -z "${EXP_EXTRA_ARGS-}" ] || { echo 'SP1 WINDOW STOP: the base arm already carries extra serve arguments' >&2; return 1; }
case "$EXTRA_DOCKER_ARGS" in *sp1-profile*) echo 'SP1 WINDOW STOP: base mounts already name sp1-profile' >&2; return 1 ;; esac
# Byte-identical to offload/launch/windows/sp1_window.py PROFILER_CONFIG (CPU test). Fields: img vllm/config/profiler.py:39-158.
SP1_PROFILER_CONFIG='{"profiler":"torch","torch_profiler_dir":"/sp1-profile","torch_profiler_activities":["CPU","CUDA"],"torch_profiler_with_stack":false,"torch_profiler_with_flops":false,"torch_profiler_record_shapes":false,"torch_profiler_with_memory":false,"torch_profiler_use_gzip":true,"torch_profiler_dump_cuda_time_total":false,"ignore_frontend":true,"detailed_trace_annotation":true,"max_iterations":16}'
EXP_EXTRA_ARGS="--profiler-config '$SP1_PROFILER_CONFIG'"
EXTRA_DOCKER_ARGS="$EXTRA_DOCKER_ARGS -v \$HOME/dsv41-offload-run/sp1-profile:/sp1-profile:rw"
LABEL=SP1-profile-327680
unset SP1_PROFILER_CONFIG
