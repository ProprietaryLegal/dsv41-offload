# PF1-CAUSE coordinator-only experiment (source from the experiment checkout root, like start_exp.sh). No service starts here.
# Exactly PF1-window.env (sourced unchanged: production's own env and read-only mounts, cap, trace switch), plus:
#  - PF1_TRACE=1: the MoE-half spans (offload/prefill_cause, hash-checked against its OVERLAY.sha256) replace K1's
#    nvidia/model.py, vllm_exl3_moe/tf_prompt.py and tf_experts.py mounts once and add their host-only helper. They
#    record into the PF1-R2 trace runtime, so they need the PF1-R2 ON sources too (PF1_TRACE=1 mounts both).
#  - PF1C_TF_TRANSIENT=0 (default 1 = production): the K1 TensorFold prompt scratch is held from start-up instead of
#    allocated per MoE call (VLLM_EXL3_TF_PROMPT_TRANSIENT=0 and ALIAS=0; +1,014 MiB held per rank, K1 README). The
#    H1 discriminator: same kernels, same arguments, the scratch allocated once at profile time.
PF1C_TF_TRANSIENT=${PF1C_TF_TRANSIENT-1}
case "$PF1C_TF_TRANSIENT" in 0|1) ;; *) echo "PF1 CAUSE STOP: PF1C_TF_TRANSIENT must be 0 or 1" >&2; return 1 ;; esac
. offload/launch/configs/PF1-window.env || return 1
if [ "$PF1C_TF_TRANSIENT" = 0 ]; then
  pf1c_env=" $EXP_DOCKER_ENV "
  for pf1c_switch in VLLM_EXL3_TF_PROMPT_TRANSIENT VLLM_EXL3_TF_PROMPT_ALIAS; do
    pf1c_rest=${pf1c_env#* $pf1c_switch=1 }
    case "$pf1c_env" in *" $pf1c_switch=1 "*) ;; *) echo "PF1 CAUSE STOP: production env lacks $pf1c_switch=1" >&2; return 1 ;; esac
    case "$pf1c_rest" in *" $pf1c_switch="*) echo "PF1 CAUSE STOP: duplicate $pf1c_switch" >&2; return 1 ;; esac
    pf1c_env=${pf1c_env/ $pf1c_switch=1 / $pf1c_switch=0 }
  done
  pf1c_env=${pf1c_env# }; EXP_DOCKER_ENV=${pf1c_env% }
fi
LABEL=PF1-cause-$PF1_CAP-trace$PF1_TRACE-tft$PF1C_TF_TRANSIENT
if [ "$PF1_TRACE" = 1 ]; then
  PF1C_ROOT=${PF1C_ROOT-offload/prefill_cause/generated}
  case "$PF1C_ROOT" in *[[:space:]]*|'') echo 'PF1 CAUSE STOP: MoE span source path empty or contains whitespace' >&2; return 1 ;; esac
  pf1c_pins=$PWD/offload/prefill_cause/OVERLAY.sha256
  (cd "$PF1C_ROOT" && sha256sum --quiet -c "$pf1c_pins") || { echo 'PF1 CAUSE STOP: MoE span sources differ from OVERLAY.sha256' >&2; return 1; }
  pf1c_lib=/usr/local/lib/python3.12/dist-packages
  pf1c_targets=" $pf1c_lib/vllm/models/deepseek_v41/nvidia/model.py $pf1c_lib/vllm_exl3_moe/tf_prompt.py $pf1c_lib/vllm_exl3_moe/tf_experts.py "
  read -r -a pf1c_tokens <<< "$EXTRA_DOCKER_ARGS"
  pf1c_kept= pf1c_dropped=0 pf1c_i=0
  while [ "$pf1c_i" -lt "${#pf1c_tokens[@]}" ]; do
    [ "${pf1c_tokens[$pf1c_i]}" = -v ] && [ $((pf1c_i + 1)) -lt "${#pf1c_tokens[@]}" ] \
      || { echo "PF1 CAUSE STOP: docker args are not '-v SRC:DST:MODE' pairs" >&2; return 1; }
    pf1c_spec=${pf1c_tokens[$((pf1c_i + 1))]}
    pf1c_dst=${pf1c_spec%:*}; pf1c_dst=${pf1c_dst#*:}
    case "$pf1c_targets" in
      *" $pf1c_dst "*) case "$pf1c_spec" in *:ro) pf1c_dropped=$((pf1c_dropped + 1)) ;;
                         *) echo "PF1 CAUSE STOP: $pf1c_dst is not a read-only production mount" >&2; return 1 ;; esac ;;
      *) pf1c_kept="${pf1c_kept:+$pf1c_kept }-v $pf1c_spec" ;;
    esac
    pf1c_i=$((pf1c_i + 2))
  done
  [ "$pf1c_dropped" = 3 ] || { echo "PF1 CAUSE STOP: expected exactly three production MoE targets, found $pf1c_dropped" >&2; return 1; }
  EXTRA_DOCKER_ARGS=$pf1c_kept
  while read -r pf1c_sha pf1c_path; do
    case " $OVERLAYS " in *"=$pf1c_lib/$pf1c_path "*) echo "PF1 CAUSE STOP: $pf1c_path is already overlaid" >&2; return 1 ;; esac
    OVERLAYS="$OVERLAYS $PF1C_ROOT/$pf1c_path=$pf1c_lib/$pf1c_path"
  done < "$pf1c_pins"
fi
unset pf1c_env pf1c_switch pf1c_rest pf1c_pins pf1c_lib pf1c_targets pf1c_tokens pf1c_kept pf1c_dropped pf1c_i \
  pf1c_spec pf1c_dst pf1c_sha pf1c_path
