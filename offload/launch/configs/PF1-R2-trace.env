# Coordinator-only: baseline K1 or isolated diagnostic. Default 0 leaves base mounts/env byte-identical.
. offload/launch/configs/D-kv6-async-pack.env
MAX_LEN_OVERRIDE=${PF1_CAP:-327680}
case "$MAX_LEN_OVERRIDE" in 327680|524288) ;; *) echo 'PF1-R2 cap must be 327680 or 524288' >&2; return 1 ;; esac
PF1_TRACE=${PF1_TRACE:-0}
case "$PF1_TRACE" in 0|1) ;; *) echo 'PF1_TRACE must be 0 or 1' >&2; return 1 ;; esac
LABEL=PF1-R2-${MAX_LEN_OVERRIDE}-trace${PF1_TRACE}
if [ "$PF1_TRACE" = 1 ]; then
  : "${PF1_TRACE_RUN:?unique public window id required}"
  case "$PF1_TRACE_RUN" in *[!a-zA-Z0-9_-]*|'') echo 'invalid PF1_TRACE_RUN' >&2; return 1 ;; esac
  PF1_TRACE_ROOT=${PF1_TRACE_ROOT:-offload/prefill_trace/generated}
  case "$PF1_TRACE_ROOT" in *[[:space:]]*) echo 'trace source path contains whitespace' >&2; return 1 ;; esac
  PF1_TRACE_PINS=$PWD/offload/prefill_trace/OVERLAY.sha256
  (cd "$PF1_TRACE_ROOT" && sha256sum --quiet -c "$PF1_TRACE_PINS") || return 1
  # Replace K1's two overlapping targets once, retaining every other mount.
  PF1_TRACE_KEEP=
  for PF1_TRACE_PAIR in $OVERLAYS; do
    PF1_TRACE_DST=${PF1_TRACE_PAIR#*=}
    case "$PF1_TRACE_DST" in
      /usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/model_runner.py|/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py) ;;
      *) PF1_TRACE_KEEP="${PF1_TRACE_KEEP:+$PF1_TRACE_KEEP }$PF1_TRACE_PAIR" ;;
    esac
  done
  OVERLAYS=$PF1_TRACE_KEEP
  while read -r PF1_TRACE_SHA PF1_TRACE_PATH; do
    OVERLAYS="$OVERLAYS $PF1_TRACE_ROOT/$PF1_TRACE_PATH=/usr/local/lib/python3.12/dist-packages/$PF1_TRACE_PATH"
  done < "$PF1_TRACE_PINS"
  EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_DSV41_PREFILL_TRACE=1 VLLM_DSV41_PREFILL_TRACE_DIR=/pf1-trace VLLM_DSV41_PREFILL_TRACE_RUN=$PF1_TRACE_RUN"
  EXTRA_DOCKER_ARGS="$EXTRA_DOCKER_ARGS -v \$HOME/dsv41-offload-run/pf1-trace/$PF1_TRACE_RUN:/pf1-trace:rw"
fi
