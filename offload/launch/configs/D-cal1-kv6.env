# D-cal1 with the drafter's freed memory spent on KV: 6.0 GiB/rank (production 3.75). Capacity finalist; model load is 2.5 GiB smaller under capacity mode, so the total footprint stays near A's.
# D = B (remote Engram, REQUIRED=1 for experiments) + C-capacity-cal1 (remote DSpark, capacity). Coordinator 2026-10-22.
OVERLAYS="offload/dspark/spark/remote_dspark=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/remote_dspark offload/dspark/spark/overlay/vllm/v1/worker/gpu/spec_decode/__init__.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/__init__.py"
EXTRA_DOCKER_ARGS="-v \$HOME/dsv41-offload-run/ofl:/opt/dsv41-ofl:ro"
EXP_DOCKER_ENV="VLLM_DSPARK_REMOTE=o1rdma://10.202.28.1:18620 VLLM_DSPARK_REMOTE_BIND=10.202.28.2 VLLM_DSPARK_REMOTE_OFL_DIR=/opt/dsv41-ofl VLLM_DSPARK_REMOTE_POLICY=capacity VLLM_DSPARK_REMOTE_IDENTITY=be2c1436fa9f9e66b398e1b1da2e140e6fddc82a11939e2ac4240a0ca79543bd VLLM_DSPARK_REMOTE_MARKOV_IDENTITY=0b6e71e638abd5abce2db433965bb5ff523cbbe92ed7ae54324a50ccaeffa19a VLLM_DSPARK_REMOTE_TIMEOUT_MS=50 VLLM_DSPARK_REMOTE_ROUND_MS=28.79,31.86,34.44,37.76,41.56,43.68 VLLM_DSPARK_REMOTE_DRAFT_MS=4.4 VLLM_DSPARK_REMOTE_LOG_EVERY=1024 PYTHONPATH=/root/.cache/dsv41-offload/offload/engram/spark/py DSV41_ENGRAM_OVERLAY=/root/.cache/dsv41-offload/offload/engram/spark/engram.py VLLM_ENGRAM_REMOTE_ROOT=/root/.cache/dsv41-offload VLLM_ENGRAM_REMOTE=rdma://10.202.28.1:18610@10.202.28.2,rdma://10.202.29.1:18610@10.202.29.2 VLLM_ENGRAM_REMOTE_TIMEOUT_MS=100 VLLM_ENGRAM_REMOTE_RETRY_MS=5000 VLLM_ENGRAM_REMOTE_REQUIRED=1 VLLM_ENGRAM_REMOTE_LOG_S=60"
