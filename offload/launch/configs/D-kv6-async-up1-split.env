# UP1 split: composed K1 + 0064 + 0067 + tap-aware0075; CPU qualified only.
# Generated, no services started. Runtime UP1_* variables override defaults; 0 disables a feature.
# D-kv6 (327,680) with KV page packing 0060 (VLLM_DSV41_KV_PAIR=3) + 0076b/d/e + factor 4; predicted pool 2,502,600 tokens (v5: 1,604,926).
# Generated by offload/kvpack/make_configs.py from D-kv6-async-process-nap-lazy.env + the K1 overlay (offload/kvpack, MANIFEST.json).
# Before the first start on a node: offload/kvpack/stage_overlay.sh check spark sparkworker (image base == overlay base).
# K1 switches (override at start; empty = off). Without the overlay mounted none of them exists in the image.
K1_KV_PAIR=${K1_KV_PAIR-3}            # KV page packing: 3 = 0060 (three 64-state pages), 1 = 0057; empty = v5 layout
K1_DROP_MTP=${K1_DROP_MTP-1}            # 0076b: no [4096, 20480] bf16 MTP residual buffer (160 MiB/rank, never read by DSpark)
K1_TF_TRANSIENT=${K1_TF_TRANSIENT-1}    # 0076d: TensorFold prompt scratch per MoE call instead of 1,014 MiB/rank held
K1_TF_ALIAS=${K1_TF_ALIAS-1}            # 0076e (with 0076d): down partials in the rotated rows' storage, call peak 1,014 -> 750 MiB
K1_INDEXER_FACTOR=${K1_INDEXER_FACTOR-4} # indexer prefill K-gather workspace factor (image default 8); empty = 8
K1_MEMPROBE=${K1_MEMPROBE-}             # 0076a: per-step memory JSONL prefix /root/.cache/dsv41-memprobe-<run>; empty = off
# memprobe opens <prefix>_r<rank>.jsonl and creates no directory: the prefix must sit directly in /root/.cache
# (= ~/.cache/dsv41-serve on each node, mounted by the launcher), or the worker dies at its first dummy step.
case "$K1_MEMPROBE" in "") ;; /root/.cache/*/*|/root/.cache/) echo "K1_MEMPROBE=$K1_MEMPROBE: use /root/.cache/<name> (no subdirectory)" >&2; return 1 ;; /root/.cache/*) ;; *) echo "K1_MEMPROBE=$K1_MEMPROBE: must start with /root/.cache/" >&2; return 1 ;; esac
K1_NODROP=${K1_NODROP-}                # disable_eagle_block_drop: NO effect in our serve (S8 N-4: with swa_bounded_replay the
#                                         flagged SWA group is not prefix-cacheable, so the drop never applies); a switch only
LABEL=D-kv6-async-up1-split
KV_BYTES_OVERRIDE=${K1_KV_BYTES-6442450944}   # 6 GiB/rank; K1_KV_BYTES=1610612736 (1.5 GiB) = pool-pressure run R1b
if [ -n "$K1_NODROP" ]; then SPEC_OVERRIDE='{"method":"dspark","num_speculative_tokens":5,"num_speculative_tokens_per_batch_size":[[1,2,5],[3,4,4]],"disable_eagle_block_drop":true}'; fi
OVERLAYS="offload/dspark/spark/overlay/vllm/v1/worker/gpu/spec_decode/__init__.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/__init__.py offload/upstream_adopt/overlay/vllm/models/deepseek_v41/attention.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/attention.py offload/upstream_adopt/overlay/vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py offload/upstream_adopt/overlay/vllm/models/deepseek_v41/common/ops/nvfp4_fi_cache.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/common/ops/nvfp4_fi_cache.py offload/upstream_adopt/overlay/vllm/models/deepseek_v41/common/ops/swa_fused.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/common/ops/swa_fused.py offload/upstream_adopt/overlay/vllm/models/deepseek_v41/nvidia/dspark.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/dspark.py offload/upstream_adopt/overlay/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py offload/upstream_adopt/overlay/vllm/models/deepseek_v41/nvidia/model.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/model.py offload/upstream_adopt/overlay/vllm/models/deepseek_v41/nvidia/model_state.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/model_state.py offload/upstream_adopt/overlay/vllm/models/deepseek_v41/replay_skip.py=/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/replay_skip.py offload/upstream_adopt/overlay/vllm/v1/attention/backends/mla/sparse_swa.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/attention/backends/mla/sparse_swa.py offload/upstream_adopt/overlay/vllm/v1/core/kv_cache_utils.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/core/kv_cache_utils.py offload/upstream_adopt/overlay/vllm/v1/core/sched/scheduler.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/core/sched/scheduler.py offload/upstream_adopt/overlay/vllm/v1/kv_cache_interface.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/kv_cache_interface.py offload/upstream_adopt/overlay/vllm/v1/worker/gpu/dsv41_memprobe.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/dsv41_memprobe.py offload/upstream_adopt/overlay/vllm/v1/worker/gpu/input_batch.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/input_batch.py offload/upstream_adopt/overlay/vllm/v1/worker/gpu/model_runner.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/model_runner.py offload/upstream_adopt/overlay/vllm/v1/worker/utils.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/utils.py offload/upstream_adopt/overlay/vllm_exl3_moe/forward.py=/usr/local/lib/python3.12/dist-packages/vllm_exl3_moe/forward.py offload/upstream_adopt/overlay/vllm_exl3_moe/smoe.py=/usr/local/lib/python3.12/dist-packages/vllm_exl3_moe/smoe.py offload/upstream_adopt/overlay/vllm_exl3_moe/tf_experts.py=/usr/local/lib/python3.12/dist-packages/vllm_exl3_moe/tf_experts.py offload/upstream_adopt/overlay/vllm_exl3_moe/tf_prompt.py=/usr/local/lib/python3.12/dist-packages/vllm_exl3_moe/tf_prompt.py offload/upstream_adopt/overlay/offload/dspark/spark/remote_dspark=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/remote_dspark"
EXTRA_DOCKER_ARGS="-v \$HOME/dsv41-offload-run/ofl:/opt/dsv41-ofl:ro"
EXP_DOCKER_ENV="VLLM_DSPARK_REMOTE=o1rdma://10.202.28.1:18620 VLLM_DSPARK_REMOTE_BIND=10.202.28.2 VLLM_DSPARK_REMOTE_OFL_DIR=/opt/dsv41-ofl VLLM_DSPARK_REMOTE_POLICY=capacity VLLM_DSPARK_REMOTE_ASYNC=1 VLLM_DSPARK_REMOTE_ASYNC_PROXY=process VLLM_DSPARK_REMOTE_BACKOFF_MAX_MS=5000 VLLM_DSPARK_REMOTE_ASYNC_SPIN_US=50 VLLM_DSPARK_REMOTE_ASYNC_NAP_US=20 VLLM_DSPARK_REMOTE_IDENTITY=be2c1436fa9f9e66b398e1b1da2e140e6fddc82a11939e2ac4240a0ca79543bd VLLM_DSPARK_REMOTE_MARKOV_IDENTITY=0b6e71e638abd5abce2db433965bb5ff523cbbe92ed7ae54324a50ccaeffa19a VLLM_DSPARK_REMOTE_TIMEOUT_MS=50 VLLM_DSPARK_REMOTE_ROUND_MS=28.79,31.86,34.44,37.76,41.56,43.68 VLLM_DSPARK_REMOTE_DRAFT_MS=4.4 VLLM_DSPARK_REMOTE_LOG_EVERY=1024 PYTHONPATH=/root/.cache/dsv41-offload/offload/engram/spark/py DSV41_ENGRAM_OVERLAY=/root/.cache/dsv41-offload/offload/engram/spark/engram.py VLLM_ENGRAM_REMOTE_ROOT=/root/.cache/dsv41-offload VLLM_ENGRAM_REMOTE=rdma://10.202.28.1:18610@10.202.28.2,rdma://10.202.29.1:18610@10.202.29.2 VLLM_ENGRAM_REMOTE_TIMEOUT_MS=100 VLLM_ENGRAM_REMOTE_RETRY_MS=5000 VLLM_ENGRAM_REMOTE_REQUIRED=1 VLLM_ENGRAM_REMOTE_LOG_S=60${K1_KV_PAIR:+ VLLM_DSV41_KV_PAIR=$K1_KV_PAIR}${K1_DROP_MTP:+ VLLM_DSV41_DROP_MTP_BUFFER=$K1_DROP_MTP}${K1_TF_TRANSIENT:+ VLLM_EXL3_TF_PROMPT_TRANSIENT=$K1_TF_TRANSIENT}${K1_TF_ALIAS:+ VLLM_EXL3_TF_PROMPT_ALIAS=$K1_TF_ALIAS}${K1_INDEXER_FACTOR:+ VLLM_INDEXER_PREFILL_BUFFER_FACTOR=$K1_INDEXER_FACTOR}${K1_MEMPROBE:+ VLLM_DSV41_MEMPROBE=$K1_MEMPROBE VLLM_DSV41_MEMPROBE_LAYERS=2,14,20}"
UP1_SPLIT=${UP1_SPLIT-63}
case "$UP1_SPLIT" in 0|63) ;; *) echo "invalid UP1_SPLIT=$UP1_SPLIT" >&2; return 1 ;; esac
UP1_VOR=${UP1_VOR-0}
case "$UP1_VOR" in 0|1|swa|copy) ;; *) echo "invalid UP1_VOR=$UP1_VOR" >&2; return 1 ;; esac
UP1_REPLAY=${UP1_REPLAY-0}
case "$UP1_REPLAY" in 0|1) ;; *) echo "invalid UP1_REPLAY=$UP1_REPLAY" >&2; return 1 ;; esac
UP1_K5=${UP1_K5-0}
case "$UP1_K5" in 0|1) ;; *) echo "invalid UP1_K5=$UP1_K5" >&2; return 1 ;; esac
UP1_DUAL_RING=${UP1_DUAL_RING-0}
case "$UP1_DUAL_RING" in 0|1) ;; *) echo "invalid UP1_DUAL_RING=$UP1_DUAL_RING" >&2; return 1 ;; esac
UP1_CPU_PIN=${UP1_CPU_PIN-0}
case "$UP1_CPU_PIN" in 0|1) ;; *) echo "invalid UP1_CPU_PIN=$UP1_CPU_PIN" >&2; return 1 ;; esac
EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_EXL3_MOE_SPLIT_MAX_TOKENS=$UP1_SPLIT VLLM_DSV41_VOR_FUSED=$UP1_VOR VLLM_DSV41_REPLAY_SKIP=$UP1_REPLAY"
if [ "$UP1_K5" = 1 ]; then
  [ -z "$K1_NODROP" ] || { echo "UP1_K5 with K1_NODROP needs an explicit combined spec" >&2; return 1; }
  SPEC_OVERRIDE='{"method":"dspark","num_speculative_tokens":5,"num_speculative_tokens_per_batch_size":[[1,4,5]]}'
fi
if [ "$UP1_DUAL_RING" = 1 ]; then EXP_DOCKER_ENV="$EXP_DOCKER_ENV EXL3_RDMA_DEVICES=rocep1s0f1,roceP2p1s0f1"; fi
if [ "$UP1_CPU_PIN" = 1 ]; then EXP_DOCKER_ENV="$EXP_DOCKER_ENV EXL3_CPU_PIN=5-9,15-19"; fi
