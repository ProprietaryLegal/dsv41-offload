# PF2-LOWKV coordinator-only arm (source from the experiment checkout root, like start_exp.sh). No service starts here.
# = PF1-window.env's OFF arm at 524,288: production's own OFFLOAD_DOCKER_ENV + OFFLOAD_DSPARK_ENV and read-only mounts from
# production's dsv41.env, port 8001, VLLM_ENGRAM_REMOTE_REQUIRED=1 (offload/prefill_maxlen/PF1-WINDOW-RECONCILE.md). Three
# additions (offload/pf2_lowkv/DESIGN.md section 2): KV_BYTES_OVERRIDE=$PF2_KV_BYTES (H = production's 6442450944, L = the
# runner's checked --low-kv-bytes), SP1's reviewed --profiler-config byte for byte (idle until POST /start_profile), and
# SP1's read-write trace directory $HOME/dsv41-offload-run/sp1-profile -> /sp1-profile (that JSON names /sp1-profile).
# The runner (offload/launch/windows/pf2_window.py) passes PF1_CAP=524288 PF1_TRACE=0 PF1_EAGER=0 PF2_KV_BYTES=<arm>.
case "${PF1_CAP-524288}:${PF1_TRACE-0}:${PF1_EAGER-0}" in
  524288:0:0) ;;
  *) echo 'PF2 WINDOW STOP: both PF2 arms are the 524,288 OFF arm (PF1_CAP=524288 PF1_TRACE=0 PF1_EAGER=0)' >&2; return 1 ;;
esac
if [ -n "${PF1_TRACE_RUN-}${PF1_TRACE_ROOT-}${SP1_PROFILER_CONFIG-}" ]; then
  echo 'PF2 WINDOW STOP: inherited PF1 trace or SP1 profiler settings are not part of this window' >&2; return 1
fi
# H is production's reservation; L is a whole number of MiB in [2 GiB, 6 GiB) (the runner also checks offload/pf2_lowkv/arith.py).
case "${PF2_KV_BYTES-}" in
  ''|*[!0-9]*) echo 'PF2 WINDOW STOP: PF2_KV_BYTES must be set to a decimal byte count' >&2; return 1 ;;
esac
if [ "$PF2_KV_BYTES" -lt 2147483648 ] || [ "$PF2_KV_BYTES" -gt 6442450944 ] || [ $((PF2_KV_BYTES % 1048576)) != 0 ]; then
  echo 'PF2 WINDOW STOP: PF2_KV_BYTES outside [2 GiB, 6 GiB] or not a whole MiB' >&2; return 1
fi
PF1_CAP=524288 PF1_TRACE=0 PF1_EAGER=0
. offload/launch/configs/PF1-window.env || return 1
[ "$KV_BYTES_OVERRIDE" = 6442450944 ] || { echo 'PF2 WINDOW STOP: the base arm is not production 6442450944' >&2; return 1; }
[ -z "${EXP_EXTRA_ARGS-}" ] || { echo 'PF2 WINDOW STOP: the base arm already carries extra serve arguments' >&2; return 1; }
case "$EXTRA_DOCKER_ARGS" in *sp1-profile*) echo 'PF2 WINDOW STOP: base mounts already name sp1-profile' >&2; return 1 ;; esac
KV_BYTES_OVERRIDE=$PF2_KV_BYTES
# Byte-identical to offload/launch/windows/sp1_window.py PROFILER_CONFIG and SP1-profile.env (CPU test).
SP1_PROFILER_CONFIG='{"profiler":"torch","torch_profiler_dir":"/sp1-profile","torch_profiler_activities":["CPU","CUDA"],"torch_profiler_with_stack":false,"torch_profiler_with_flops":false,"torch_profiler_record_shapes":false,"torch_profiler_with_memory":false,"torch_profiler_use_gzip":true,"torch_profiler_dump_cuda_time_total":false,"ignore_frontend":true,"detailed_trace_annotation":true,"max_iterations":16}'
EXP_EXTRA_ARGS="--profiler-config '$SP1_PROFILER_CONFIG'"
EXTRA_DOCKER_ARGS="$EXTRA_DOCKER_ARGS -v \$HOME/dsv41-offload-run/sp1-profile:/sp1-profile:rw"
LABEL=PF2-lowkv-524288-kv$PF2_KV_BYTES
unset SP1_PROFILER_CONFIG
