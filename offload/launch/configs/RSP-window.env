# R-SP coordinator-only experiment (source from the experiment checkout root, like start_exp.sh). No service starts here.
# Exactly PF1-window.env's OFF arm (production's own env and read-only mounts, cap, VLLM_ENGRAM_REMOTE_REQUIRED=1), plus:
#  - RSP_SP=1: the R-SP build (offload/sp_prefill, hash-checked against its OVERLAY.sha256) replaces K1's nvidia/model.py
#    mount once and adds vllm/models/deepseek_v41/sp_prefill.py, and VLLM_DSV41_PREFILL_SP=1 switches it on.
#    RSP_SP=0 (default) is the control: the production launch unchanged.
# PF1's trace and eager switches are not part of this window.
RSP_SP=${RSP_SP-0}
case "$RSP_SP" in 0|1) ;; *) echo "RSP WINDOW STOP: RSP_SP must be 0 or 1" >&2; return 1 ;; esac
case "${PF1_TRACE-0}:${PF1_EAGER-0}" in 0:0) ;; *) echo "RSP WINDOW STOP: PF1 trace/eager switches are not part of this window" >&2; return 1 ;; esac
. offload/launch/configs/PF1-window.env || return 1
LABEL=RSP-window-$PF1_CAP-sp$RSP_SP
if [ "$RSP_SP" = 1 ]; then
  RSP_ROOT=${RSP_ROOT-offload/sp_prefill/generated}
  case "$RSP_ROOT" in *[[:space:]]*|'') echo 'RSP WINDOW STOP: R-SP source path empty or contains whitespace' >&2; return 1 ;; esac
  rsp_pins=$PWD/offload/sp_prefill/OVERLAY.sha256
  (cd "$RSP_ROOT" && sha256sum --quiet -c "$rsp_pins") || { echo 'RSP WINDOW STOP: R-SP sources differ from OVERLAY.sha256' >&2; return 1; }
  rsp_lib=/usr/local/lib/python3.12/dist-packages
  rsp_target=$rsp_lib/vllm/models/deepseek_v41/nvidia/model.py
  read -r -a rsp_tokens <<< "$EXTRA_DOCKER_ARGS"
  rsp_kept= rsp_dropped=0 rsp_i=0
  while [ "$rsp_i" -lt "${#rsp_tokens[@]}" ]; do
    [ "${rsp_tokens[$rsp_i]}" = -v ] && [ $((rsp_i + 1)) -lt "${#rsp_tokens[@]}" ] \
      || { echo "RSP WINDOW STOP: docker args are not '-v SRC:DST:MODE' pairs" >&2; return 1; }
    rsp_spec=${rsp_tokens[$((rsp_i + 1))]}
    rsp_dst=${rsp_spec%:*}; rsp_dst=${rsp_dst#*:}
    if [ "$rsp_dst" = "$rsp_target" ]; then
      case "$rsp_spec" in *:ro) rsp_dropped=$((rsp_dropped + 1)) ;;
        *) echo "RSP WINDOW STOP: $rsp_dst is not a read-only production mount" >&2; return 1 ;; esac
    else
      rsp_kept="${rsp_kept:+$rsp_kept }-v $rsp_spec"
    fi
    rsp_i=$((rsp_i + 2))
  done
  [ "$rsp_dropped" = 1 ] || { echo "RSP WINDOW STOP: expected exactly one production model.py mount, found $rsp_dropped" >&2; return 1; }
  EXTRA_DOCKER_ARGS=$rsp_kept
  while read -r rsp_sha rsp_path; do
    case " $OVERLAYS " in *"=$rsp_lib/$rsp_path "*) echo "RSP WINDOW STOP: $rsp_path is already overlaid" >&2; return 1 ;; esac
    OVERLAYS="${OVERLAYS:+$OVERLAYS }$RSP_ROOT/$rsp_path=$rsp_lib/$rsp_path"
  done < "$rsp_pins"
  case " $EXP_DOCKER_ENV " in *" VLLM_DSV41_PREFILL_SP="*) echo 'RSP WINDOW STOP: production already sets VLLM_DSV41_PREFILL_SP' >&2; return 1 ;; esac
  EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_DSV41_PREFILL_SP=1"
fi
unset rsp_pins rsp_lib rsp_target rsp_tokens rsp_kept rsp_dropped rsp_i rsp_spec rsp_dst rsp_sha rsp_path
