# DSV41-OFFLOAD lane O3: remote DSpark, CAPACITY policy, ASYNC rounds (rank 0's CPU never blocks: the engine stream
# waits on a host word (streamsync.HostFlagSync); self-tested at startup, falls back to synchronous rounds with a warning). Otherwise as C-capacity:
# no local drafter on either Spark (no draft weights, Markov
# cache, draft graphs or draft KV layers). Failed rounds verify nothing (zero drafts, confidence 0 -> depth 0).
# REMOTE_ROUND_MS / REMOTE_DRAFT_MS below are PLACEHOLDERS (live ROUND_MS minus an assumed 3.6 ms local drafter; 4.0 ms
# remote round): replace them with the shadow run's measurements (INTEGRATION.md step 3) before timing runs.
# KV_BYTES_OVERRIDE stays at production until the reclaimed memory is measured (INTEGRATION.md step 4).
# Transport: ofl RDMA (needs libofl.so + ofl.py in ~/dsv41-offload-run/ofl on both nodes, INTEGRATION.md 1.3);
# o1tcp:// selects ofl's TCP backend for debugging (same worker, same port).
LABEL=C-capacity-async
OVERLAYS="offload/dspark/spark/remote_dspark=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/remote_dspark offload/dspark/spark/overlay/vllm/v1/worker/gpu/spec_decode/__init__.py=/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/__init__.py"
EXTRA_DOCKER_ARGS="-v \$HOME/dsv41-offload-run/ofl:/opt/dsv41-ofl:ro"
EXP_DOCKER_ENV="VLLM_DSPARK_REMOTE=o1rdma://10.202.28.1:18620 VLLM_DSPARK_REMOTE_BIND=10.202.28.2 VLLM_DSPARK_REMOTE_OFL_DIR=/opt/dsv41-ofl VLLM_DSPARK_REMOTE_POLICY=capacity VLLM_DSPARK_REMOTE_ASYNC=1 VLLM_DSPARK_REMOTE_IDENTITY=be2c1436fa9f9e66b398e1b1da2e140e6fddc82a11939e2ac4240a0ca79543bd VLLM_DSPARK_REMOTE_MARKOV_IDENTITY=0b6e71e638abd5abce2db433965bb5ff523cbbe92ed7ae54324a50ccaeffa19a VLLM_DSPARK_REMOTE_TIMEOUT_MS=50 VLLM_DSPARK_REMOTE_ROUND_MS=29.66,32.73,35.31,38.63,42.43,44.55 VLLM_DSPARK_REMOTE_DRAFT_MS=4.0 VLLM_DSPARK_REMOTE_LOG_EVERY=1024"
