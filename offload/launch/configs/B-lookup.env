# Section 8 (optional n-gram speculation): B + the engine's own prompt-lookup drafts layered on DSpark (patch 0043,
# upstream setting 3,8,0.5: n-gram 3-8, used only where its measured acceptance beats the confidence head). Local, no
# network. Compared against B on copy-heavy legal workloads (extract, summary) at 32K; rejected if not better.
LABEL=B-lookup
EXP_DOCKER_ENV="PYTHONPATH=/root/.cache/dsv41-offload/offload/engram/spark/py DSV41_ENGRAM_OVERLAY=/root/.cache/dsv41-offload/offload/engram/spark/engram.py VLLM_ENGRAM_REMOTE_ROOT=/root/.cache/dsv41-offload VLLM_ENGRAM_REMOTE=rdma://10.202.28.1:18610@10.202.28.2,rdma://10.202.29.1:18610@10.202.29.2 VLLM_ENGRAM_REMOTE_TIMEOUT_MS=100 VLLM_ENGRAM_REMOTE_RETRY_MS=5000 VLLM_ENGRAM_REMOTE_REQUIRED=1 VLLM_ENGRAM_REMOTE_LOG_S=60 VLLM_DSPARK_LOOKUP=3,8,0.5"
