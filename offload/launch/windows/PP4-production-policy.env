# Coordinator-only PP4 production-policy control (R-PP4, role P). Source from the separate clean experiment checkout.
# Identical to PP4-sampled.env's greedy role A (same source, verifier overlay, remote_dspark, mounts, PP4 worker identity
# and round-trace mount) except that production's own policy stays in place: no fixed-depth/lookup/margin/adaptive-off
# tokens, and no SPEC_OVERRIDE, so serve_exp.sh applies production's per-batch schedule [[1,2,5],[3,4,4]] and its
# VLLM_DSV41_ADAPTIVE_K=1 / AK_* defaults exactly as production serve.sh does. Nothing else differs.
case "${PP4_ROLE-}" in P) ;; *) echo 'PP4-P STOP: role P required' >&2; return 1;; esac
# Stripping the appended policy tokens below is exact only while production's own env sets none of those keys.
pp4p_prod=$(set +u; . "$HOME/dsv41-deploy/dsv41.env" >/dev/null || exit 1
  printf '%s %s' "${OFFLOAD_DOCKER_ENV-}" "${OFFLOAD_DSPARK_ENV-}") || return 1
for pp4p_token in $pp4p_prod; do
  case "$pp4p_token" in
    VLLM_DSV41_ADAPTIVE_K=*|VLLM_DSV41_AK_*|VLLM_DSPARK_DEPTH_POLICY=*|VLLM_DSPARK_DEPTH_FILE=*|VLLM_DSPARK_LOOKUP=*|VLLM_DSPARK_REMOTE_WANT_MARGIN=*|VLLM_DSPARK_SAMPLED_TOP32=*)
      echo "PP4-P STOP: production dsv41.env sets ${pp4p_token%%=*}; this control would drop it" >&2; return 1;;
  esac
done
PP4_ROLE=A
. offload/launch/windows/PP4-sampled.env || return 1
PP4_ROLE=P
pp4p_env=
for pp4p_token in $EXP_DOCKER_ENV; do
  case "$pp4p_token" in
    VLLM_DSV41_ADAPTIVE_K=0|VLLM_DSPARK_DEPTH_POLICY=fixed:5|VLLM_DSPARK_DEPTH_FILE=|VLLM_DSPARK_LOOKUP=|VLLM_DSPARK_REMOTE_WANT_MARGIN=0) ;;
    *) pp4p_env="${pp4p_env:+$pp4p_env }$pp4p_token";;
  esac
done
case " $pp4p_env " in *" VLLM_DSPARK_SAMPLED_TOP32=0 "*) ;; *) echo 'PP4-P STOP: greedy switch missing' >&2; return 1;; esac
EXP_DOCKER_ENV=$pp4p_env
unset SPEC_OVERRIDE
LABEL=PP4-P-production-policy
unset pp4p_prod pp4p_token pp4p_env
