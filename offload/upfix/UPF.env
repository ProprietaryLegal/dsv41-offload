# R-UPF arms for offload/launch/start_exp.sh: UPS1 #4 (henryous 0091, six vLLM robustness fixes) and UPS1 #5 (fixed persistent
# top-k, vLLM #62467/#62936/#63475). Everything OFF by default: with UPF_0091=0 and UPF_TOPK=0 this is exactly its base config
# (offload/upfix/tests/test_configs.py). Source from the repository root, like start_exp.sh. Arms: offload/upfix/configs.py;
# windows: offload/upfix/WINDOW.md.
UPF_BASE=${UPF_BASE-k1}   # k1 = K1 production equivalent (D-kv6-async-pack.env); 0075 = UP2 replay-skip scheduler (UP2-0075.env)
UPF_0091=${UPF_0091-0}    # 1 = mount the four 0091 files (offload/upfix/MANIFEST-0091.json)
UPF_TOPK=${UPF_TOPK-0}    # 1 = indexer_topk.py overlay + the built dsv41_topk library + VLLM_DSV41_TOPK_FIX=1
case "$UPF_BASE" in k1|0075) ;; *) echo "invalid UPF_BASE=$UPF_BASE" >&2; return 1 ;; esac
case "$UPF_0091" in 0|1) ;; *) echo "invalid UPF_0091=$UPF_0091" >&2; return 1 ;; esac
case "$UPF_TOPK" in 0|1) ;; *) echo "invalid UPF_TOPK=$UPF_TOPK" >&2; return 1 ;; esac
if [ "$UPF_BASE" = k1 ]; then source offload/launch/configs/D-kv6-async-pack.env; else source offload/launch/configs/UP2-0075.env; fi
UPF_PY=/usr/local/lib/python3.12/dist-packages
UPF_SCHED=vllm/v1/core/sched/scheduler.py
if [ "$UPF_0091" = 1 ]; then
  for upf_rel in vllm/distributed/device_communicators/shm_broadcast.py vllm/v1/kv_offload/tiering/async_lookup.py vllm/v1/worker/gpu/block_table.py; do
    case " $OVERLAYS " in *"=$UPF_PY/$upf_rel "*) echo "UPF_0091: the base config already mounts $upf_rel" >&2; return 1 ;; esac
    OVERLAYS="$OVERLAYS offload/upfix/overlay/$upf_rel=$UPF_PY/$upf_rel"
  done
  if [ "$UPF_BASE" = k1 ]; then
    case " $OVERLAYS " in *"=$UPF_PY/$UPF_SCHED "*) echo "UPF_0091: the K1 base already mounts a scheduler" >&2; return 1 ;; esac
    OVERLAYS="$OVERLAYS offload/upfix/overlay/$UPF_SCHED=$UPF_PY/$UPF_SCHED"
  else
    # replay_guard admits only the UP2 scheduler source; composing 0091 with replay skipping needs a reviewed guard change.
    [ "$UP2_REPLAY" = 0 ] || { echo "UPF_0091 with UP2_REPLAY=1: replay_guard admits only the UP2 scheduler (R-UPF report)" >&2; return 1; }
    upf_old="offload/upstream_adopt/overlay/$UPF_SCHED=$UPF_PY/$UPF_SCHED"
    upf_new="offload/upfix/overlay-0075/$UPF_SCHED=$UPF_PY/$UPF_SCHED"
    case " $OVERLAYS " in *" $upf_old "*) ;; *) echo "UPF_0091: the UP2 base lacks its scheduler mount" >&2; return 1 ;; esac
    OVERLAYS=" $OVERLAYS "; OVERLAYS=${OVERLAYS/" $upf_old "/" $upf_new "}; OVERLAYS=${OVERLAYS# }; OVERLAYS=${OVERLAYS% }
  fi
fi
if [ "$UPF_TOPK" = 1 ]; then
  python3 -m offload.upfix.configs verify-topk || return 1
  upf_rel=vllm/model_executor/layers/indexer_topk.py
  case " $OVERLAYS " in *"=$UPF_PY/$upf_rel "*) echo "UPF_TOPK: the base config already mounts $upf_rel" >&2; return 1 ;; esac
  OVERLAYS="$OVERLAYS offload/upfix/topk/overlay/$upf_rel=$UPF_PY/$upf_rel offload/upfix/topk/build/jit/dsv41_topk.so=/opt/dsv41-upfix/dsv41_topk.so"
  EXP_DOCKER_ENV="$EXP_DOCKER_ENV VLLM_DSV41_TOPK_FIX=1 VLLM_DSV41_TOPK_FIX_SO=/opt/dsv41-upfix/dsv41_topk.so"
fi
if [ "$UPF_0091$UPF_TOPK" != 00 ]; then LABEL="$LABEL-upf0091$UPF_0091-topk$UPF_TOPK"; fi
