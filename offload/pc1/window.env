# PC1 only. Exact production base, one isolated arm; never source the historical UP1/PF1 configs.
for pc1_key in K1_KV_PAIR K1_DROP_MTP K1_TF_TRANSIENT K1_TF_ALIAS K1_INDEXER_FACTOR K1_KV_BYTES K1_MEMPROBE K1_NODROP \
    SPEC_OVERRIDE EXP_EXTRA_ARGS OVERLAYS EXTRA_DOCKER_ARGS EXP_DOCKER_ENV KV_BYTES_OVERRIDE MAX_LEN_OVERRIDE; do
  if [ -n "${!pc1_key-}" ]; then echo "PC1 STOP: inherited $pc1_key" >&2; return 1; fi
done
PC1_ARM=${PC1_ARM-control}
case "$PC1_ARM" in control|chunk2048|threshold2048|threshold512|chunk8192|chunk16384) ;; *) echo 'PC1 STOP: isolated arm required' >&2; return 1 ;; esac
PC1_PROD_ENV=${PC1_PROD_ENV-$HOME/dsv41-deploy/dsv41.env}
pc1_prod=$(set +u; . "$PC1_PROD_ENV" >/dev/null || exit 1
  printf '%s\n' "${OFFLOAD_DOCKER_ENV-}" "${OFFLOAD_DSPARK_ENV-}" "${OFFLOAD_DOCKER_ARGS-}" \
    "${PROD_KV_BYTES-}" "${PROD_MAX_LEN-}" "${PROD_K1-}" "${PROD_K1_PROFILE-}") || return 1
mapfile -t pc1_lines <<< "$pc1_prod"
[ "${#pc1_lines[@]}" = 7 ] && [ "${pc1_lines[3]}:${pc1_lines[4]}:${pc1_lines[5]}:${pc1_lines[6]}" = 6442450944:327680:1:327680 ] \
  || { echo 'PC1 STOP: production KV/cap/K1 changed' >&2; return 1; }
MAX_LEN_OVERRIDE=${pc1_lines[4]}
KV_BYTES_OVERRIDE=${pc1_lines[3]}
EXP_DOCKER_ENV="${pc1_lines[0]} ${pc1_lines[1]}"
EXTRA_DOCKER_ARGS=${pc1_lines[2]}
OVERLAYS=
LABEL=PC1-$PC1_ARM
# Candidate knobs are valid only inside the reviewed experiment checkout on8001.
[ "${PORT:-8001}" = 8001 ] && [ "$(pwd -P)" != "$(realpath "$HOME/dsv41-deploy")" ] \
  || { echo 'PC1 STOP: separate experiment checkout and port8001 required' >&2; return 1; }
PC1_REVIEWED=1
unset pc1_key pc1_prod pc1_lines
