+def _prefill_workspace_rows(reserved_rows: int, chunk_rows: list[int]) -> int:
+    """Host-known maximum gather extent, including query-continuation chunks.
+
+    The profile reservation stays unchanged. All views are made once before
+    the loop so skip_kv_gather continuations reuse the same values AND scales.
+    No device scalar read, reallocation, altered split or changed kernel shape.
+    """
+    if reserved_rows < 0 or any(rows < 0 for rows in chunk_rows):
+        raise ValueError("Indexer prefill workspace row counts must be nonnegative")
+    rows = max(chunk_rows, default=0)
+    if rows > reserved_rows:
+        raise ValueError(
+            f"Indexer prefill gather needs {rows} rows, reservation is {reserved_rows}"
+        )
+    return rows
+
