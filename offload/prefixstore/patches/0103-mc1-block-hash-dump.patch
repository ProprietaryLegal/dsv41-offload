+    def _dsv41_label_jobs(self, meta: OffloadingConnectorMetadata) -> None:
+        """MC1 hash dump: attach each job's offload keys, in the CPU spec's chunk order, to its GPU spec so every
+        rank can name each block by (key, sub-block). Keys are pinned or allocated in the primary tier here."""
+        policy = getattr(getattr(self.manager, "primary_tier", None), "_policy", None)
+        if policy is None:
+            raise ValueError("MC1 hash dump needs the tiering manager's CPU primary tier")
+        for jobs, gpu_side, cpu_side in (
+            (meta.load_jobs, "dst_spec", "src_spec"),
+            (meta.store_jobs, "src_spec", "dst_spec"),
+        ):
+            for job_id, job in jobs.items():
+                gpu_spec = getattr(job, gpu_side)
+                if getattr(gpu_spec, "dsv41_stream", None) == "fail":
+                    continue
+                try:
+                    position = {
+                        int(c): i for i, c in enumerate(getattr(job, cpu_side).block_ids)
+                    }
+                    order = sorted(
+                        self._jobs[job_id].keys,
+                        key=lambda k: position[policy.get(k).chunk_id],
+                    )
+                except (AttributeError, KeyError):
+                    # Never stop a diagnostic window over a label: the job's blocks are dumped
+                    # unlabeled and blockhash_compare fails the gate on them, loudly.
+                    logger.error("MC1 hash dump: cannot label job %d with its keys", job_id)
+                    continue
+                setattr(gpu_spec, "dsv41_keys", [k.hex() for k in order])
+
     def _dsv41_streaming(self, req_id: ReqId) -> bool:
