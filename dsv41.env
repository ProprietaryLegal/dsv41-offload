# DeepSeek-V4.1-Flash-1017 EXL3 2.75bpw TP2 deployment config (sourced by start/stop/status/logs/bench)
HEAD=spark                 # sparkhead (rank 0), ssh alias -> 127.0.0.1
WORKER=sparkworker              # sparkworker / rank1user (rank 1), ssh alias -> 10.202.26.1 (direct CX-7 link)
FAB_IF=enp1s0f1np1         # 200 Gb/s direct link, 10.202.26.2 (head) <-> 10.202.26.1 (worker)
FAB_HCA=rocep1s0f1         # RoCE device of FAB_IF; second PCIe function roceP2p1s0f1 (10.202.27.x) also used by NCCL
# Served model: legal v2a, adopted by the user 2026-10-21. Rollback to the baseline: MODEL_DIR=/srv/dsv41/model ./start.sh
#  /srv/dsv41/legal-v2a  head: symlink -> /home/rank0user/models/DeepSeek-V4.1-Flash-1017-EXL3-legal-v2a ; worker: hardlink tree on local NVMe
#  /srv/dsv41/model      baseline 2.75bpw (unchanged). head: symlink -> /home/rank0user/models/DeepSeek-V4.1-Flash-1017-EXL3-2.75bpw-DGX-Spark ; worker: local NVMe dir
MODEL_DIR=${MODEL_DIR:-/srv/dsv41/legal-v2a}
IMAGE=ghcr.io/henryous/deepseek-v41-1017-dgx-spark:v5
SERVED=DeepSeek-V4.1-Flash-1017-EXL3-Spark-TP2
PORT=8000                  # API: http://HEAD_IP:8000/v1 (LAN) / http://localhost:8000/v1
SERVE_DIR=dsv41-deploy/run # generated launch file per node, under each node's home (recipe default /tmp is wiped at reboot; SPARKFIX1022 2026-10-22)
RECIPE=$HOME/dgx-spark-deepseek-v41   # sudoingX launcher @ cc59c36
QUANT_REV=86f852533ec94d1a537fea41fd9c01d6b0f6eb50
BASE_REV=1bae0e1088993b9b82de08f59de5be5a34e42170
# inference settings live in serve.sh (author's v5 serve_example.sh; see serve.sh.diff for local changes):
# MAX_LEN=327680 MAX_SEQS=4 MAX_BATCH=4096 KV_BYTES=3.75GiB/rank UTIL=0.86 SPEC=dspark k5@1-2 / k4@3-4 streams
# (configuration D below overrides KV to 6.0 GiB/rank via PROD_KV_BYTES and the drafter via OFFLOAD_DSPARK_ENV)
GPU_CLOCK_CAP=${GPU_CLOCK_CAP-2150}         # nvidia-smi -lgc 0,$GPU_CLOCK_CAP on both nodes at start (non-persistent; resets on reboot). Empty = stock. Author's fallback: 2000
# DSV41-OFFLOAD configuration B (2026-10-22, offload/results/COMPARISON.md): Engram rows from x86host's RAM over each node's
# 40 Gb/s RDMA link (x86host unit dsv41-engram.service), local NVMe kept as the exact fallback. Prompt reading ~5.5 % faster
# at 32K-150K; outputs identical; no Spark memory change. REQUIRED=0: the serve boots and reads locally if x86host is down,
# then attaches when it is back (retry every 5 s). Roll back to A: comment out the next line, then ./stop.sh && ./start.sh
OFFLOAD_DOCKER_ENV="PYTHONPATH=/root/.cache/dsv41-offload/offload/engram/spark/py DSV41_ENGRAM_OVERLAY=/root/.cache/dsv41-offload/offload/engram/spark/engram.py VLLM_ENGRAM_REMOTE_ROOT=/root/.cache/dsv41-offload VLLM_ENGRAM_REMOTE=rdma://10.202.28.1:18610@10.202.28.2,rdma://10.202.29.1:18610@10.202.29.2 VLLM_ENGRAM_REMOTE_TIMEOUT_MS=100 VLLM_ENGRAM_REMOTE_RETRY_MS=5000 VLLM_ENGRAM_REMOTE_REQUIRED=0 VLLM_ENGRAM_REMOTE_LOG_S=60 VLLM_DSV41_KV_PAIR=3 VLLM_DSV41_DROP_MTP_BUFFER=1 VLLM_EXL3_TF_PROMPT_TRANSIENT=1 VLLM_EXL3_TF_PROMPT_ALIAS=1 VLLM_INDEXER_PREFILL_BUFFER_FACTOR=4"
# DSV41-OFFLOAD configuration D (2026-10-22, NDM: adopt the context/concurrency gain; offload/results/COMPARISON.md):
# B + the DSpark drafter on x86host's RTX 3090 GPU-c4e7a371 (systemd --user dsv41-dspark-worker, 10.202.28.1:18620,
# capacity policy: no drafter on the Sparks) and its freed memory spent on KV: 6.0 GiB/rank = 1,604,926 tokens (4.9 x
# 327,680) vs 989,460. Cost: single-stream decode ~7-9 % slower; under concurrency <= 2 %. Worker down -> target-only
# rounds (slower, correct); reconnect retries back off to at most 5 s (drill 2026-10-23: the 30 s default cap reconnected
# 20 s after the worker was ready). Rollback to B: comment out the four lines below, then ./stop.sh && ./start.sh
# D-async (R3-PROMOTE, offload/promote/async-tp2/README.md; window 4: TP2 worker + this env -3.9 to -6.5 % per round vs
# synchronous D with TTFT at parity, 0 watchdog fires): rank 0 does not block on the remote round; the round runs in a
# torch-free proxy process (respawned up to 3 times per hour of service if it dies or stalls; else target-only rounds,
# outputs unchanged). CUDA_MODULE_LOADING stays LAZY; start.sh sends one warm-up request (offload/launch/warmup_serve.sh).
# Rollback to synchronous D: put the # on the async line and take it off the line below it, then ./stop.sh && ./start.sh
OFFLOAD_DSPARK_ENV="VLLM_DSPARK_REMOTE=o1rdma://10.202.28.1:18620 VLLM_DSPARK_REMOTE_BIND=10.202.28.2 VLLM_DSPARK_REMOTE_OFL_DIR=/opt/dsv41-ofl VLLM_DSPARK_REMOTE_POLICY=capacity VLLM_DSPARK_REMOTE_IDENTITY=be2c1436fa9f9e66b398e1b1da2e140e6fddc82a11939e2ac4240a0ca79543bd VLLM_DSPARK_REMOTE_MARKOV_IDENTITY=0b6e71e638abd5abce2db433965bb5ff523cbbe92ed7ae54324a50ccaeffa19a VLLM_DSPARK_REMOTE_TIMEOUT_MS=50 VLLM_DSPARK_REMOTE_ROUND_MS=28.79,31.86,34.44,37.76,41.56,43.68 VLLM_DSPARK_REMOTE_DRAFT_MS=4.4 VLLM_DSPARK_REMOTE_LOG_EVERY=1024 VLLM_DSPARK_REMOTE_BACKOFF_MAX_MS=5000 VLLM_DSPARK_REMOTE_ASYNC=1 VLLM_DSPARK_REMOTE_ASYNC_PROXY=process VLLM_DSPARK_REMOTE_ASYNC_SPIN_US=50 VLLM_DSPARK_REMOTE_ASYNC_NAP_US=20 VLLM_DSPARK_REMOTE_ASYNC_RESPAWNS=3 VLLM_DSPARK_REMOTE_ASYNC_RESPAWN_RESET_S=3600"
#OFFLOAD_DSPARK_ENV="VLLM_DSPARK_REMOTE=o1rdma://10.202.28.1:18620 VLLM_DSPARK_REMOTE_BIND=10.202.28.2 VLLM_DSPARK_REMOTE_OFL_DIR=/opt/dsv41-ofl VLLM_DSPARK_REMOTE_POLICY=capacity VLLM_DSPARK_REMOTE_IDENTITY=be2c1436fa9f9e66b398e1b1da2e140e6fddc82a11939e2ac4240a0ca79543bd VLLM_DSPARK_REMOTE_MARKOV_IDENTITY=0b6e71e638abd5abce2db433965bb5ff523cbbe92ed7ae54324a50ccaeffa19a VLLM_DSPARK_REMOTE_TIMEOUT_MS=50 VLLM_DSPARK_REMOTE_ROUND_MS=28.79,31.86,34.44,37.76,41.56,43.68 VLLM_DSPARK_REMOTE_DRAFT_MS=4.4 VLLM_DSPARK_REMOTE_LOG_EVERY=1024 VLLM_DSPARK_REMOTE_BACKOFF_MAX_MS=5000"
OFFLOAD_DOCKER_ARGS="-v \$HOME/dsv41-offload-prod/dspark/ofl:/opt/dsv41-ofl:ro -v \$HOME/dsv41-offload-prod/dspark/remote_dspark:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/remote_dspark:ro -v \$HOME/dsv41-offload-prod/dspark/spec_decode__init__.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/__init__.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/models/deepseek_v41/attention.py:/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/attention.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py:/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/models/deepseek_v41/common/ops/nvfp4_fi_cache.py:/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/common/ops/nvfp4_fi_cache.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/models/deepseek_v41/nvidia/dspark.py:/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/dspark.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py:/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/models/deepseek_v41/nvidia/model.py:/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/model.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/v1/core/kv_cache_utils.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/core/kv_cache_utils.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/v1/kv_cache_interface.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/kv_cache_interface.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/v1/worker/utils.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/utils.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/v1/worker/gpu/model_runner.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/model_runner.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/v1/worker/gpu/dsv41_memprobe.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/dsv41_memprobe.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm_exl3_moe/tf_prompt.py:/usr/local/lib/python3.12/dist-packages/vllm_exl3_moe/tf_prompt.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm_exl3_moe/tf_experts.py:/usr/local/lib/python3.12/dist-packages/vllm_exl3_moe/tf_experts.py:ro"
PROD_KV_BYTES=6442450944
PROD_MAX_LEN=327680
# K1 packing at the unchanged cap; S18 window 6 PROMOTE.
PROD_K1=1
PROD_K1_PROFILE=327680
